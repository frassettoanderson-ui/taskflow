# Modelo de configuração. Copie este arquivo para ".env" e ajuste se quiser.
# (o .env já vem criado no projeto para você não precisar fazer nada)

# Banco de dados
POSTGRES_USER=restaurante
POSTGRES_PASSWORD=restaurante
POSTGRES_DB=restaurante

# Segredo usado para assinar o "crachá" de login (JWT).
# Em produção isto DEVE ser trocado por um valor longo e aleatório.
JWT_SECRET=troque-este-segredo-em-producao
