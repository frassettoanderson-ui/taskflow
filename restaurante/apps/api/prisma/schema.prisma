// Desenho do banco de dados.
//
// REGRA DE OURO DESTE PROJETO (multi-tenant):
// todo dado pertence a um TENANT (a empresa cliente). Toda tabela — menos a
// própria Tenant — carrega "tenantId". A MARCA (Brand) é entidade de primeira
// classe: um tenant pode ter várias marcas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Papéis de acesso dentro de um tenant.
enum Role {
  OWNER // dono
  MANAGER // gerente
  CASHIER // caixa — fecha conta e recebe pagamento
  WAITER // garçom — lança pedido e atende chamados, NÃO mexe em dinheiro
  OPERATOR // operador de cozinha
}

/// A empresa cliente do SaaS. É a raiz do isolamento de dados.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  User[]
  brands Brand[]

  @@map("tenants")
}

/// Usuário do painel (dono, gerente ou operador de UM tenant).
model User {
  id String @id @default(cuid())

  // ---- isolamento por tenant ----
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name         String
  email        String @unique // ver "pontas soltas": por ora o e-mail é único no sistema inteiro
  passwordHash String
  role         Role   @default(OPERATOR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pedidosLancados Order[]        @relation("PedidosDoGarcom")
  comandas        TableSession[] @relation("ComandasDoGarcom")
  chamadosAtendidos ServiceCall[] @relation("ChamadosAtendidos")
  acertos           Payout[]

  @@index([tenantId])
  @@map("users")
}

/// A marca (ex.: "Cantina da Nona"). Um tenant pode ter várias.
/// O cardápio, na Etapa 1, vai pendurar aqui.
model Brand {
  id String @id @default(cuid())

  // ---- isolamento por tenant ----
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String
  /// endereço público do cardápio: /m/<slug>
  /// Único no sistema INTEIRO (não só dentro da empresa), porque é um link
  /// que qualquer pessoa acessa sem login.
  slug String @unique

  // white-label básico: a página do cardápio se pinta com isto
  primaryColor String  @default("#E11D48")
  logoUrl      String?
  description  String? // frase curta que aparece no topo do cardápio

  /// Pausar a marca inteira: o cardápio sai do ar na hora e nenhum pedido entra.
  paused       Boolean @default(false)
  pausedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menus        Menu[]
  orders       Order[]
  units        BrandUnit[]
  customers    TenantCustomer[]
  deliveryArea DeliveryArea[]
  openingHours OpeningHour[]
  tables       Table[]
  sessions     TableSession[]

  // Etapa 4 — CRM e marketing
  loyalty        LoyaltyProgram?
  coupons        Coupon[]
  cashbackCodes  CashbackCode[]
  campaigns      Campaign[]
  abandonedCarts AbandonedCart[]
  npsResponses   NpsResponse[]

  // Etapa 6 — portal
  portalListing PortalListing?

  @@index([tenantId])
  @@map("brands")
}

// ===========================================================================
//  CATÁLOGO  (Etapa 1)
//  O cardápio pertence à MARCA e a um CANAL — a mesma marca pode ter preços
//  e itens diferentes no delivery, no salão e no balcão.
// ===========================================================================

/// Canal de venda.
enum SalesChannel {
  DELIVERY // entrega
  DINE_IN // salão
  COUNTER // balcão / retirada
}

/// O cardápio de uma marca em um canal.
model Menu {
  id String @id @default(cuid())

  tenantId String
  brandId  String
  brand    Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  channel  SalesChannel

  name   String
  active Boolean @default(true)

  categories Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, channel])
  @@index([tenantId])
  @@map("menus")
}

/// Seção do cardápio: "Entradas", "Massas", "Bebidas"...
model Category {
  id String @id @default(cuid())

  tenantId String
  menuId   String
  menu     Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  items Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([menuId])
  @@map("categories")
}

/// Um produto do cardápio.
model Item {
  id String @id @default(cuid())

  tenantId   String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name        String
  description String?
  /// SEMPRE em centavos. Nunca usamos número com vírgula para dinheiro.
  priceCents  Int
  imageUrl    String?
  sortOrder   Int     @default(0)
  /// "pausar item" — some do cardápio sem ser apagado
  active      Boolean @default(true)

  /// Para qual estação da cozinha este item vai (chapa, montagem, bebidas...).
  /// Vazio = cai na estação padrão.
  stationId String?
  station   Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]
  unitOverrides  UnitItemOverride[]
  /// a ficha técnica deste prato (Etapa 5)
  recipe         RecipeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([categoryId])
  @@map("items")
}

/// Grupo de complementos de um item: "Ponto da carne", "Adicionais"...
model ModifierGroup {
  id String @id @default(cuid())

  tenantId String
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  name String
  /// quantas opções o cliente PRECISA escolher (0 = opcional)
  minSelect Int @default(0)
  /// quantas ele PODE escolher no máximo
  maxSelect Int @default(1)
  sortOrder Int @default(0)

  modifiers Modifier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([itemId])
  @@map("modifier_groups")
}

/// Uma opção dentro do grupo: "Bem passado", "Bacon extra +R$ 6,00"...
model Modifier {
  id String @id @default(cuid())

  tenantId String
  groupId  String
  group    ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name String
  /// quanto SOMA ao preço do item (em centavos; pode ser 0)
  priceDeltaCents Int     @default(0)
  sortOrder       Int     @default(0)
  active          Boolean @default(true)

  orderItemModifiers OrderItemModifier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([groupId])
  @@map("modifiers")
}

// ===========================================================================
//  PEDIDO  (Etapa 1)
// ===========================================================================

/// De onde o pedido veio. É isto que decide se há comissão do portal.
enum OrderSource {
  DIRECT // canal próprio do restaurante — SEM comissão
  PORTAL // veio do nosso marketplace — COM comissão embutida
  IFOOD // importado do iFood
}

/// Os estados por que um pedido passa.
enum OrderStatus {
  AWAITING_PAYMENT // aguardando pagamento
  RECEIVED // recebido (caiu na cozinha)
  ACCEPTED // aceito
  IN_PREPARATION // em preparo
  READY // pronto
  OUT_FOR_DELIVERY // saiu para entrega
  DELIVERED // entregue
  CANCELED // cancelado
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CARD
  CASH
}

model Order {
  id String @id @default(cuid())

  tenantId String
  brandId  String
  brand    Brand        @relation(fields: [brandId], references: [id])
  channel  SalesChannel @default(DELIVERY)
  source   OrderSource  @default(DIRECT)

  /// Em qual loja/cozinha este pedido é produzido.
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  /// Cliente da MARCA (a base é de cada marca, nunca compartilhada).
  customerId String?
  customer   TenantCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // ---- salão (Etapa 3) ----
  /// Em qual mesa este pedido foi feito.
  tableId String?
  table   Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  /// A comanda da mesa — junta as várias rodadas de pedido numa conta só.
  tableSessionId String?
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  /// Qual garçom lançou (vazio = o próprio cliente pediu pelo QR ou totem).
  waiterId String?
  waiter   User?   @relation("PedidosDoGarcom", fields: [waiterId], references: [id], onDelete: SetNull)

  /// código curto que o cliente usa para acompanhar (ex.: "A7K2QD")
  code String @unique

  /// Apelido que o CAIXA gerou no aparelho dele, antes de o servidor saber
  /// do pedido. É o que impede a venda feita sem internet de virar duas quando
  /// a conexão volta e o aparelho reenvia: se o apelido já existe, devolvemos
  /// o pedido que já está gravado em vez de criar outro.
  clientRef String? @unique

  status OrderStatus @default(AWAITING_PAYMENT)

  // ---- cliente (sem cadastro: só o necessário para entregar) ----
  customerName    String
  customerPhone   String
  addressStreet   String?
  addressNumber   String?
  addressDistrict String?
  addressCity     String?
  addressNote     String?

  /// pedido agendado para depois (null = "para agora")
  scheduledFor DateTime?

  // ---- dinheiro, sempre em centavos ----
  //
  // A conta do total:
  //   total = subtotal − desconto do cupom − cashback usado + frete
  subtotalCents    Int @default(0)
  deliveryFeeCents Int @default(0)
  /// desconto vindo do cupom
  discountCents    Int @default(0)
  /// quanto do pedido foi pago com cashback
  cashbackRedeemedCents Int @default(0)
  /// quanto de cashback ESTE pedido gerou (creditado ao ser entregue)
  cashbackEarnedCents   Int @default(0)
  totalCents       Int @default(0)

  /// cupom usado (guardamos o código também, caso o cupom seja apagado depois)
  couponId           String?
  coupon             Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCodeSnapshot String?

  notes String?

  /// Quando o estoque deste pedido foi baixado (evita baixar duas vezes).
  stockConsumedAt DateTime?

  // ---- portal (Etapa 6) ----
  /// Quanto do preço deste pedido foi a comissão embutida do portal.
  /// Em pedido do canal direto isto é sempre zero.
  portalMarkupCents Int @default(0)
  /// O cupom de graduação gerado para o cliente pedir direto na próxima vez.
  graduationCouponCode String?

  items    OrderItem[]
  events   OrderEvent[]
  payment  Payment?
  cashback CashbackEntry[]
  nps      NpsResponse?
  dispatch Dispatch?
  split    OrderSplit?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([brandId, status])
  @@index([tenantId, createdAt])
  @@map("orders")
}

/// Uma linha do pedido.
/// Guardamos CÓPIA do nome e do preço: se o cardápio mudar amanhã,
/// o pedido de hoje continua contando a história certa.
model OrderItem {
  id String @id @default(cuid())

  tenantId String
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  /// Para qual estação da cozinha esta linha vai.
  /// Guardamos CÓPIA do nome: se a estação for renomeada ou apagada amanhã,
  /// a comanda de hoje continua legível.
  stationId           String?
  station             Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  stationNameSnapshot String?

  nameSnapshot   String
  unitPriceCents Int
  quantity       Int @default(1)
  /// (preço do item + complementos) x quantidade
  totalCents     Int

  notes String?

  modifiers OrderItemModifier[]

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id String @id @default(cuid())

  tenantId    String
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  modifierId String?
  modifier   Modifier? @relation(fields: [modifierId], references: [id], onDelete: SetNull)

  nameSnapshot    String
  priceDeltaCents Int

  @@index([tenantId])
  @@index([orderItemId])
  @@map("order_item_modifiers")
}

/// Histórico de eventos de domínio do pedido.
/// Cada mudança de estado grava uma linha aqui — é a "certidão de nascimento"
/// do pedido e a base para o KDS, o rastreio e, mais pra frente, o BI.
model OrderEvent {
  id String @id @default(cuid())

  tenantId String
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// ex.: "order.created", "order.status_changed", "order.paid"
  type String
  /// detalhes livres (status anterior, quem mudou, etc.)
  payload Json?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([orderId, createdAt])
  @@map("order_events")
}

/// A cobrança do pedido, criada pelo PaymentProvider.
model Payment {
  id String @id @default(cuid())

  tenantId String

  /// Um pagamento pertence a UM pedido (delivery) OU a UMA comanda de mesa.
  /// Na mesa pode haver vários — é assim que a conta é dividida.
  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  tableSessionId String?
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)

  /// qual adaptador gerou (hoje: "fake-pix")
  provider   String
  externalId String        @unique
  method     PaymentMethod @default(PIX)
  status     PaymentStatus @default(PENDING)
  amountCents Int

  /// Pix: o "copia e cola" e a imagem do QR
  qrCode      String?
  qrCodeImage String?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tableSessionId])
  @@map("payments")
}

// ===========================================================================
//  SALÃO  (Etapa 3)
// ===========================================================================

enum TableStatus {
  FREE // livre
  OCCUPIED // ocupada
  BILL_REQUESTED // pediu a conta
  RESERVED // reservada
  BLOCKED // bloqueada (manutenção)
}

enum SessionStatus {
  OPEN // comanda aberta, ainda pedindo
  CLOSING // conta fechada, aguardando pagamento
  PAID // quitada
  CANCELED
}

enum ServiceCallType {
  WAITER // chamar garçom
  BILL // pedir a conta
}

enum ServiceCallStatus {
  PENDING
  DONE
}

enum ReservationStatus {
  CONFIRMED
  SEATED
  CANCELED
  NO_SHOW
}

enum WaitlistStatus {
  WAITING
  CALLED
  SEATED
  GAVE_UP
}

/// Uma mesa do salão.
/// Pertence a UMA marca — é assim que o QR sabe qual cardápio abrir.
model Table {
  id String @id @default(cuid())

  tenantId String
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  brandId  String
  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  /// o que está escrito na mesa: "5", "V2"
  number String
  area   String @default("Salão")
  seats  Int    @default(4)

  /// posição no mapa de mesas (grade simples)
  posX Int @default(0)
  posY Int @default(0)

  /// o que vai dentro do QR Code: /mesa/<qrToken>
  qrToken String      @unique
  status  TableStatus @default(FREE)
  active  Boolean     @default(true)

  sessions     TableSession[]
  orders       Order[]
  calls        ServiceCall[]
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, number])
  @@index([tenantId])
  @@map("tables")
}

/// A COMANDA DA MESA — o coração do salão.
///
/// Abre quando alguém senta e fecha quando a conta é paga. Junta as várias
/// rodadas de pedido (entrada, prato, sobremesa) numa conta só.
model TableSession {
  id String @id @default(cuid())

  tenantId String
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tableId  String
  table    Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  brandId  String
  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  /// código curto que o cliente vê na tela do celular
  code   String        @unique
  status SessionStatus @default(OPEN)
  guests Int           @default(1)

  /// garçom responsável (vazio quando o cliente pediu sozinho pelo QR)
  waiterId String?
  waiter   User?   @relation("ComandasDoGarcom", fields: [waiterId], references: [id], onDelete: SetNull)

  /// taxa de serviço: 1000 = 10%. Pode ser desligada pelo cliente.
  serviceFeeBps     Int     @default(1000)
  serviceFeeEnabled Boolean @default(true)

  // ---- valores, sempre em centavos ----
  subtotalCents   Int @default(0)
  serviceFeeCents Int @default(0)
  totalCents      Int @default(0)
  /// quanto já entrou (a conta pode ser paga em partes)
  paidCents       Int @default(0)

  notes String?

  openedAt DateTime  @default(now())
  closedAt DateTime?

  orders   Order[]
  payments Payment[]
  calls    ServiceCall[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tableId, status])
  @@map("table_sessions")
}

/// "Chamar garçom" e "pedir a conta".
model ServiceCall {
  id String @id @default(cuid())

  tenantId String
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tableId  String
  table    Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  sessionId String?
  session   TableSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  type   ServiceCallType
  status ServiceCallStatus @default(PENDING)
  note   String?

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("ChamadosAtendidos", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([unitId, status])
  @@map("service_calls")
}

/// Reserva de mesa.
model Reservation {
  id String @id @default(cuid())

  tenantId String
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tableId  String?
  table    Table? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  name   String
  phone  String
  guests Int    @default(2)
  /// quando o cliente chega
  when   DateTime
  status ReservationStatus @default(CONFIRMED)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([unitId, when])
  @@map("reservations")
}

/// Fila de espera (quando não há mesa livre).
model WaitlistEntry {
  id String @id @default(cuid())

  tenantId String
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  name   String
  phone  String
  guests Int            @default(2)
  status WaitlistStatus @default(WAITING)

  calledAt DateTime?
  seatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([unitId, status])
  @@map("waitlist")
}

// ===========================================================================
//  MULTIMARCA, MULTICANAL E MULTIUNIDADE  (Etapa 2)
// ===========================================================================

/// A loja física: onde a comida é produzida. Tem CNPJ próprio.
/// Uma dark kitchen é UMA unidade com VÁRIAS marcas dentro.
model Unit {
  id String @id @default(cuid())

  tenantId String

  name String
  cnpj String?

  addressStreet   String?
  addressNumber   String?
  addressDistrict String?
  addressCity     String?

  /// Coordenadas — é daqui que sai a conta de distância para o frete por raio.
  latitude  Float?
  longitude Float?

  active Boolean @default(true)

  /// Taxa de serviço padrão do salão, em pontos-base (1000 = 10%).
  serviceFeeBps Int @default(1000)

  brands    BrandUnit[]
  stations  Station[]
  orders    Order[]
  overrides UnitItemOverride[]
  tables    Table[]
  sessions  TableSession[]
  calls     ServiceCall[]
  reservations Reservation[]
  waitlist  WaitlistEntry[]
  supplies  Supply[]
  couriers  Courier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("units")
}

/// Quais marcas operam em quais unidades.
model BrandUnit {
  id String @id @default(cuid())

  tenantId String
  brandId  String
  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  active Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([brandId, unitId])
  @@index([tenantId])
  @@map("brand_units")
}

/// Estação de produção dentro de uma unidade: Chapa, Montagem, Forno, Bebidas.
/// É o que faz o KDS mandar cada item para a tela certa.
model Station {
  id String @id @default(cuid())

  tenantId String
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  items      Item[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([unitId])
  @@map("stations")
}

/// A EXCEÇÃO LOCAL do cardápio central.
///
/// O cardápio é da marca — você edita uma vez e vale para todas as unidades.
/// Esta tabela existe só para o caso "nesta loja acabou o camarão hoje" ou
/// "nesta loja o preço é outro". É exceção, não regra.
model UnitItemOverride {
  id String @id @default(cuid())

  tenantId String
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// pausado só nesta unidade
  paused Boolean @default(false)
  /// preço diferente só nesta unidade (vazio = usa o preço da marca)
  priceCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, itemId])
  @@index([tenantId])
  @@map("unit_item_overrides")
}

/// Cliente de uma MARCA.
///
/// Princípio "seus clientes, seus dados": a base é por marca. O mesmo telefone
/// pedindo na Cantina e na Burger vira dois cadastros — são negócios distintos,
/// e o dia que uma marca sair, ela leva a base dela.
model TenantCustomer {
  id String @id @default(cuid())

  tenantId String
  brandId  String
  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name  String
  phone String

  /// resumo, para o CRM não precisar somar pedido por pedido
  ordersCount     Int       @default(0)
  totalSpentCents Int       @default(0)
  lastOrderAt     DateTime?
  firstOrderAt    DateTime?

  /// saldo de cashback DESTA marca (é a soma do extrato; guardado aqui só
  /// para a tela não precisar somar tudo toda vez)
  cashbackBalanceCents Int @default(0)

  /// último endereço usado — poupa o cliente de redigitar
  addressStreet   String?
  addressNumber   String?
  addressDistrict String?
  addressCity     String?
  addressNote     String?

  /// o cliente pediu para não receber campanha
  optOut Boolean @default(false)

  /// Ligação com a carteira da REDE (o portal, Etapa 6).
  /// Existe desde já para o dia de ligar o portal não exigir mexer no passado.
  networkCustomerId String?
  networkCustomer   NetworkCustomer? @relation(fields: [networkCustomerId], references: [id], onDelete: SetNull)

  /// LGPD: quando os dados pessoais foram anonimizados a pedido do cliente
  anonymizedAt DateTime?

  orders      Order[]
  cashback    CashbackEntry[]
  redemptions CouponRedemption[]
  messages    OutboundMessage[]
  npsAnswers  NpsResponse[]
  consents    ConsentRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, phone])
  @@index([tenantId])
  @@index([tenantId, lastOrderAt])
  @@map("tenant_customers")
}

/// A CARTEIRA DA REDE — preparada agora, ligada de verdade na Etapa 6 (Portal).
///
/// Aqui o telefone é único no sistema INTEIRO: é a mesma pessoa, vista pelo
/// portal. Cada TenantCustomer aponta para ela, sem que as marcas passem a
/// enxergar a base uma da outra.
model NetworkCustomer {
  id String @id @default(cuid())

  phone String  @unique
  name  String?

  /// carteira de cashback da rede (Etapa 6)
  walletCents Int @default(0)

  tenantCustomers TenantCustomer[]
  walletEntries   NetworkWalletEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("network_customers")
}

// ===========================================================================
//  FIDELIDADE E CASHBACK  (Etapa 4)
// ===========================================================================

/// As regras de cashback de uma marca. Tudo configurável.
model LoyaltyProgram {
  id String @id @default(cuid())

  tenantId String
  brandId  String @unique
  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  active Boolean @default(true)

  /// quanto o cliente ganha de volta, em pontos-base (500 = 5%)
  cashbackBps Int @default(500)
  /// só gera cashback a partir deste valor de pedido
  minOrderCents Int @default(0)
  /// quantos dias o crédito vale
  expiresInDays Int @default(90)
  /// no resgate, quanto do pedido pode ser pago com cashback (5000 = 50%)
  maxRedeemBps Int @default(5000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("loyalty_programs")
}

enum CashbackEntryType {
  EARN // ganhou
  REDEEM // usou
  EXPIRE // venceu
  ADJUST // ajuste manual
}

/// O EXTRATO do cashback.
///
/// Por que extrato e não um campo "saldo": com um número só, ninguém sabe de
/// onde veio nem quando vence. Aqui o saldo é a soma das linhas — dá para
/// auditar, expirar o que passou da validade e corrigir sem perder a história.
model CashbackEntry {
  id String @id @default(cuid())

  tenantId   String
  customerId String
  customer   TenantCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type CashbackEntryType
  /// positivo quando entra, negativo quando sai
  amountCents Int

  /// de qual pedido veio (ou em qual foi usado)
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  description String?
  /// quando este crédito vence (só para EARN)
  expiresAt DateTime?
  /// marcado quando o vencimento já foi processado
  expiredAt DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([customerId, createdAt])
  @@index([expiresAt])
  @@map("cashback_entries")
}

/// Código de confirmação para GASTAR cashback.
///
/// Sem isto, quem soubesse o telefone de outra pessoa gastava o cashback dela:
/// o telefone identificava o cliente e mais nada era pedido. Agora, para usar o
/// saldo, o cliente confirma um código de 6 dígitos enviado no canal dele.
///
/// O código nunca é guardado em texto: fica só o resumo (hash). Se o banco
/// vazar, os códigos não servem para nada — e eles expiram em minutos.
model CashbackCode {
  id String @id @default(cuid())

  tenantId String
  brandId  String
  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  /// só dígitos, do mesmo jeito que o cliente é procurado
  phone String

  /// resumo do código, nunca o código
  codeHash  String
  expiresAt DateTime

  /// quantas vezes erraram: passou do limite, o código morre
  attempts Int @default(0)

  /// quando foi confirmado (a partir daí vale o token)
  confirmedAt DateTime?
  /// a senha temporária que autoriza o resgate no fechamento do pedido
  redeemToken String?   @unique
  tokenUsedAt DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([brandId, phone, createdAt])
  @@map("cashback_codes")
}

// ===========================================================================
//  CUPONS  (Etapa 4)
// ===========================================================================

enum CouponType {
  PERCENT // desconto percentual
  FIXED // desconto de valor fixo
  FREE_DELIVERY // frete grátis
}

/// A quem a promoção se destina.
enum CustomerSegment {
  ALL // todos
  FIRST_ORDER // quem nunca pediu nesta marca
  INACTIVE // não pede há X dias
  RECURRING // pediu 3 vezes ou mais
  NEW // pediu pela primeira vez há pouco tempo
}

model Coupon {
  id String @id @default(cuid())

  tenantId String
  brandId  String
  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  /// o que o cliente digita
  code        String
  description String?

  type       CouponType
  /// PERCENT: pontos-base (1000 = 10%). FIXED: centavos. FREE_DELIVERY: ignorado.
  value      Int        @default(0)
  /// teto do desconto em centavos (0 = sem teto), útil no percentual
  maxDiscountCents Int  @default(0)
  minOrderCents    Int  @default(0)

  // ---- a quem e quando vale ----
  segment CustomerSegment @default(ALL)
  /// para o segmento INACTIVE: quantos dias sem pedir
  inactiveDays Int @default(30)

  /// dias da semana em que vale (0=domingo). Vazio = todos.
  weekdays Int[] @default([])
  /// faixa de horário em minutos desde a meia-noite. Vazio = o dia todo.
  hourFromMinutes Int?
  hourToMinutes   Int?

  validFrom  DateTime?
  validUntil DateTime?

  /// 0 = sem limite
  usageLimit            Int @default(0)
  usageLimitPerCustomer Int @default(1)
  usedCount             Int @default(0)

  active Boolean @default(true)

  redemptions CouponRedemption[]
  orders      Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, code])
  @@index([tenantId])
  @@map("coupons")
}

model CouponRedemption {
  id String @id @default(cuid())

  tenantId   String
  couponId   String
  coupon     Coupon         @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId String
  customer   TenantCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  orderId       String?
  discountCents Int

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([couponId, customerId])
  @@map("coupon_redemptions")
}

// ===========================================================================
//  CAMPANHAS, MENSAGENS E RECUPERAÇÃO  (Etapa 4)
// ===========================================================================

enum CampaignStatus {
  DRAFT
  QUEUED
  SENDING
  DONE
  FAILED
}

model Campaign {
  id String @id @default(cuid())

  tenantId String
  brandId  String
  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name    String
  message String

  segment      CustomerSegment @default(ALL)
  inactiveDays Int             @default(30)

  status       CampaignStatus @default(DRAFT)
  scheduledFor DateTime?

  // ---- resultado ----
  recipientCount Int @default(0)
  sentCount      Int @default(0)
  failedCount    Int @default(0)

  startedAt  DateTime?
  finishedAt DateTime?

  messages OutboundMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("campaigns")
}

enum MessageKind {
  CAMPAIGN
  CART_RECOVERY
  NPS
  ORDER_UPDATE
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
}

/// TUDO que o sistema mandou (ou tentou mandar) para um cliente.
/// Enquanto o WhatsApp é fake, é aqui que você confere o que "foi enviado".
model OutboundMessage {
  id String @id @default(cuid())

  tenantId String
  brandId  String?

  customerId String?
  customer   TenantCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  kind    MessageKind
  channel String      @default("WHATSAPP")
  to      String
  body    String

  status     MessageStatus @default(PENDING)
  providerId String?
  error      String?
  sentAt     DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([campaignId])
  @@map("outbound_messages")
}

enum AbandonedCartStatus {
  OPEN // parado, ainda dentro do prazo
  NOTIFIED // já mandamos o lembrete
  RECOVERED // o cliente voltou e fechou
  EXPIRED // desistiu
}

/// Carrinho que ficou parado sem virar pedido.
model AbandonedCart {
  id String @id @default(cuid())

  tenantId String
  brandId  String
  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  /// identificação do navegador, para o mesmo carrinho não duplicar
  clientKey String

  name  String?
  phone String?

  /// o que estava no carrinho, como o cliente montou
  items         Json
  subtotalCents Int  @default(0)

  status     AbandonedCartStatus @default(OPEN)
  notifiedAt DateTime?
  recoveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, clientKey])
  @@index([tenantId, status])
  @@map("abandoned_carts")
}

// ===========================================================================
//  PESQUISA DE SATISFAÇÃO (NPS)  (Etapa 4)
// ===========================================================================

// ===========================================================================
//  ESTOQUE E FICHA TÉCNICA  (Etapa 5)
// ===========================================================================

/// Unidade de medida do insumo.
enum SupplyUnit {
  KG
  G
  L
  ML
  UN
}

/// O insumo: farinha, queijo, embalagem, gás.
model Supply {
  id String @id @default(cuid())

  tenantId String
  unitId   String?
  unit     Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  name     String
  /// em que medida ele é comprado e consumido
  measure  SupplyUnit @default(UN)
  /// quanto custa UMA unidade de medida (1 kg, 1 L, 1 unidade), em centavos
  costPerUnitCents Int @default(0)

  /// quanto tem em estoque agora
  stockQty    Float @default(0)
  /// abaixo disto, o sistema avisa
  minStockQty Float @default(0)

  active Boolean @default(true)

  recipeItems RecipeItem[]
  movements   StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("supplies")
}

/// A FICHA TÉCNICA: quanto de cada insumo entra num prato.
///
/// A perda (%) é o que se descarta no preparo — casca, aparas, evaporação.
/// Ela entra no custo porque o restaurante paga por ela do mesmo jeito.
model RecipeItem {
  id String @id @default(cuid())

  tenantId String
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplyId String
  supply   Supply @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  /// quantidade LÍQUIDA usada no prato, na medida do insumo
  quantity     Float
  /// percentual de perda (10 = 10%)
  wastePercent Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, supplyId])
  @@index([tenantId])
  @@map("recipe_items")
}

enum StockMovementType {
  IN // compra / entrada
  OUT // saída por venda
  RETURN // devolução (pedido cancelado)
  LOSS // perda, quebra, vencimento
  ADJUST // acerto de inventário
}

/// Todo movimento de estoque. É o extrato do almoxarifado.
model StockMovement {
  id String @id @default(cuid())

  tenantId String
  supplyId String
  supply   Supply @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  type     StockMovementType
  /// positivo entra, negativo sai
  quantity Float
  /// custo unitário no momento do movimento (para o CMV histórico)
  unitCostCents Int?

  orderId String?
  note    String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([supplyId, createdAt])
  @@map("stock_movements")
}

// ===========================================================================
//  ENTREGADORES  (Etapa 5)
// ===========================================================================

/// Como o entregador é pago.
enum CourierPayModel {
  PERCENT_OF_FEE // fatia do frete (a regra da Etapa 1: 90% do frete)
  FIXED_PER_DELIVERY // valor fixo por corrida (frota própria)
}

model Courier {
  id String @id @default(cuid())

  tenantId String
  unitId   String?
  unit     Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  name    String
  phone   String
  vehicle String @default("Moto")

  payModel      CourierPayModel @default(PERCENT_OF_FEE)
  /// quando é valor fixo, quanto ele recebe por entrega
  fixedPayCents Int             @default(0)

  active Boolean @default(true)

  // ---- pool da rede (Etapa 6) ----
  /// O entregador aceita corridas de OUTROS restaurantes do portal.
  /// É opt-in dele: por padrão só atende quem o cadastrou.
  acceptsNetworkPool Boolean @default(false)
  /// até quantos km da cozinha ele topa buscar
  serviceRadiusKm    Float   @default(8)
  /// onde ele costuma ficar (vazio = usa a unidade)
  baseLatitude  Float?
  baseLongitude Float?

  dispatches Dispatch[]
  payouts    Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("couriers")
}

enum DispatchStatus {
  SEARCHING // procurando entregador
  ASSIGNED // atribuído
  PICKED_UP // saiu com o pedido
  DELIVERED // entregou
  CANCELED
}

/// A corrida: um pedido nas mãos de um entregador.
model Dispatch {
  id String @id @default(cuid())

  tenantId String
  orderId  String @unique
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  courierId String?
  courier   Courier? @relation(fields: [courierId], references: [id], onDelete: SetNull)

  status DispatchStatus @default(SEARCHING)
  /// id da corrida no serviço externo (hoje, no fake)
  externalId String?
  /// código curto de rastreio para o cliente
  trackingCode String @unique

  distanceKm Float?
  /// quanto o entregador recebe por esta corrida
  courierPayoutCents Int @default(0)

  assignedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  canceledAt  DateTime?

  /// em qual acerto esta corrida entrou
  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([courierId, createdAt])
  @@map("dispatches")
}

// ===========================================================================
//  FINANCEIRO  (Etapa 5)
// ===========================================================================

enum EntryType {
  RECEIVABLE // a receber
  PAYABLE // a pagar
}

enum EntryStatus {
  OPEN // em aberto
  PAID // quitado
  CANCELED
}

/// Um lançamento financeiro: a receber ou a pagar.
///
/// As vendas viram lançamentos sozinhas; as despesas são lançadas à mão.
model AccountEntry {
  id String @id @default(cuid())

  tenantId String
  brandId  String?
  unitId   String?

  type   EntryType
  status EntryStatus @default(OPEN)

  /// "Vendas", "Insumos", "Aluguel", "Acerto de motoboy"...
  category    String
  description String
  amountCents Int

  dueDate DateTime
  paidAt  DateTime?

  /// de onde veio (venda ou acerto)
  orderId  String?
  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  /// para quem se paga
  party String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, dueDate])
  @@index([tenantId, type, status])
  @@map("account_entries")
}

enum PayoutKind {
  COURIER // acerto de motoboy
  WAITER // acerto de garçom
}

enum PayoutStatus {
  OPEN
  PAID
}

/// O acerto fechado de um período: "o que devo ao Tiago nesta semana".
model Payout {
  id String @id @default(cuid())

  tenantId String
  kind     PayoutKind

  courierId String?
  courier   Courier? @relation(fields: [courierId], references: [id], onDelete: SetNull)
  /// quando é garçom, aponta para o usuário
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  periodFrom DateTime
  periodTo   DateTime

  /// quantas entregas (ou pedidos) entraram
  itemsCount  Int          @default(0)
  amountCents Int          @default(0)
  status      PayoutStatus @default(OPEN)
  paidAt      DateTime?
  notes       String?

  dispatches Dispatch[]
  entries    AccountEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, kind])
  @@map("payouts")
}

// ===========================================================================
//  LGPD  (Etapa 5)
// ===========================================================================

enum ConsentType {
  MARKETING // receber promoções
  DATA_PROCESSING // uso dos dados
}

/// Registro de consentimento — quando o cliente autorizou (ou revogou).
model ConsentRecord {
  id String @id @default(cuid())

  tenantId   String
  customerId String
  customer   TenantCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type    ConsentType
  granted Boolean
  /// de onde veio: "checkout", "painel", "whatsapp"
  source  String

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([customerId, type])
  @@map("consent_records")
}

// ===========================================================================
//  PORTAL — o marketplace da rede  (Etapa 6)
// ===========================================================================

/// O OPT-IN da marca no portal.
///
/// A existência desta linha com active=true é a ÚNICA coisa que autoriza a
/// marca a aparecer para gente de fora do tenant dela. Sem isso, ela continua
/// invisível — o padrão é não aparecer.
model PortalListing {
  id String @id @default(cuid())

  tenantId String
  brandId  String @unique
  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  active Boolean @default(false)

  /// "Italiana", "Hambúrguer", "Japonesa"...
  category String
  /// frase curta que aparece no card da vitrine
  headline String?
  coverUrl String?

  /// Comissão embutida no preço, em pontos-base. Vazio = usa o padrão do sistema.
  /// IMPORTANTE: é um ACRÉSCIMO no preço do portal, não um desconto no que o
  /// restaurante recebe. Ele continua recebendo o valor cheio do cardápio dele.
  commissionBps Int?

  /// de onde a marca atende (para a busca por proximidade)
  latitude  Float?
  longitude Float?
  city      String?

  /// quantos pedidos o portal já trouxe para esta marca
  ordersFromPortal Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, category])
  @@map("portal_listings")
}

/// A DIVISÃO DO DINHEIRO, gravada por pedido.
///
/// Antes desta etapa o split era calculado na hora e esquecido. Agora fica
/// registrado: é o que permite conferir depois quem recebeu o quê, e é o que o
/// gateway real vai executar na Etapa 7.
model OrderSplit {
  id String @id @default(cuid())

  tenantId String
  orderId  String @unique
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  totalCents Int

  // ---- os três lados ----
  restaurantCents Int
  platformCents   Int
  courierCents    Int @default(0)

  // ---- de onde veio cada pedaço da parte da plataforma ----
  portalCommissionCents    Int @default(0)
  paymentFeeCents          Int @default(0)
  deliveryPlatformFeeCents Int @default(0)

  // ---- os recebedores no gateway (hoje fakes) ----
  restaurantRecipientId String
  platformRecipientId   String
  courierRecipientId    String?

  provider String @default("fake-pix")

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("order_splits")
}

enum NetworkWalletType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
}

/// O extrato da CARTEIRA DA REDE.
///
/// Diferente do cashback da marca (que só vale naquele restaurante), este
/// saldo vale em QUALQUER marca do portal. É o que faz o consumidor voltar
/// ao portal — e é a moeda do marketing coletivo.
model NetworkWalletEntry {
  id String @id @default(cuid())

  networkCustomerId String
  networkCustomer   NetworkCustomer @relation(fields: [networkCustomerId], references: [id], onDelete: Cascade)

  type        NetworkWalletType
  amountCents Int

  /// em qual pedido foi ganho ou usado (sem expor o tenant)
  orderCode   String?
  brandName   String?
  description String?
  expiresAt   DateTime?
  expiredAt   DateTime?

  createdAt DateTime @default(now())

  @@index([networkCustomerId, createdAt])
  @@map("network_wallet_entries")
}

// ===========================================================================
//  ASSINATURA DO SaaS  (Etapa 6)
// ===========================================================================

/// Um plano de assinatura. A cobrança é POR TENANT, não por marca — quem opera
/// várias marcas na mesma cozinha não é punido por isso.
model Plan {
  id String @id @default(cuid())

  code        String  @unique
  name        String
  description String?

  monthlyPriceCents Int
  /// 0 = sem limite
  maxBrands         Int @default(0)
  maxOrdersPerMonth Int @default(0)

  /// Quanto custa CADA pedido que passar do limite do plano.
  /// Decisão do fundador: o pedido nunca é bloqueado — cobra-se o excedente.
  /// 0 = o excedente é de graça (só avisa).
  overagePriceCents Int @default(0)

  features String[] @default([])
  active   Boolean  @default(true)
  sortOrder Int     @default(0)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

enum SubscriptionStatus {
  TRIALING // em teste grátis
  ACTIVE
  PAST_DUE // fatura vencida
  CANCELED
}

model Subscription {
  id String @id @default(cuid())

  tenantId String @unique
  planId   String
  plan     Plan   @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(TRIALING)

  startedAt          DateTime  @default(now())
  trialEndsAt        DateTime?
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  canceledAt         DateTime?

  /// id da assinatura no cobrador (hoje, no fake)
  externalId String?

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

enum InvoiceStatus {
  OPEN
  PAID
  OVERDUE
  CANCELED
}

model Invoice {
  id String @id @default(cuid())

  tenantId       String
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  number String @unique

  periodFrom DateTime
  periodTo   DateTime

  /// o total da fatura = mensalidade + excedente
  amountCents Int
  /// as duas partes, separadas, para a fatura conseguir se explicar
  planCents    Int @default(0)
  overageCents Int @default(0)
  /// quantos pedidos passaram do limite no período
  overageOrders Int @default(0)

  status      InvoiceStatus @default(OPEN)
  dueDate     DateTime
  paidAt      DateTime?

  externalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, dueDate])
  @@map("invoices")
}

model NpsResponse {
  id String @id @default(cuid())

  tenantId String
  brandId  String
  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  orderId String  @unique
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  customerId String?
  customer   TenantCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// link público de resposta: /avaliar/<token>
  token String @unique

  /// 0 a 10 (vazio enquanto não respondeu)
  score   Int?
  comment String?

  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@map("nps_responses")
}

/// De que jeito a marca define para onde entrega.
enum DeliveryAreaKind {
  DISTRICT // por bairro: cada bairro tem seu frete
  RADIUS // por distância: faixas de km
}

/// Uma regra de área de entrega. A marca usa um dos dois jeitos.
model DeliveryArea {
  id String @id @default(cuid())

  tenantId String
  brandId  String       @map("brandId")
  brand    Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  channel  SalesChannel @default(DELIVERY)

  kind DeliveryAreaKind

  /// quando kind = DISTRICT
  districtName String?
  /// quando kind = RADIUS: vale até esta distância (em km)
  maxDistanceKm Float?

  feeCents      Int
  /// pedido mínimo para esta área (0 = sem mínimo)
  minOrderCents Int     @default(0)
  active        Boolean @default(true)
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([brandId, channel])
  @@map("delivery_areas")
}

/// Horário de funcionamento por marca e canal.
/// Uma marca pode abrir só à noite no delivery e o dia todo no balcão.
model OpeningHour {
  id String @id @default(cuid())

  tenantId String
  brandId  String
  brand    Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  channel  SalesChannel @default(DELIVERY)

  /// 0 = domingo, 1 = segunda, ... 6 = sábado
  weekday Int
  /// minutos desde a meia-noite (ex.: 11h30 = 690). Evita fuso e formato de hora.
  opensAtMinutes  Int
  closesAtMinutes Int

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([brandId, channel, weekday])
  @@map("opening_hours")
}

/// Avisos de gateway já processados — garante IDEMPOTÊNCIA.
/// Se o mesmo aviso chegar duas vezes, a segunda é ignorada.
model ProcessedWebhook {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@map("processed_webhooks")
}
