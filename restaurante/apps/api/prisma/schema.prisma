// Desenho do banco de dados.
//
// REGRA DE OURO DESTE PROJETO (multi-tenant):
// todo dado pertence a um TENANT (a empresa cliente). Toda tabela — menos a
// própria Tenant — carrega "tenantId". A MARCA (Brand) é entidade de primeira
// classe: um tenant pode ter várias marcas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Papéis de acesso dentro de um tenant.
enum Role {
  OWNER // dono
  MANAGER // gerente
  CASHIER // caixa — fecha conta e recebe pagamento
  WAITER // garçom — lança pedido e atende chamados, NÃO mexe em dinheiro
  OPERATOR // operador de cozinha
}

/// A empresa cliente do SaaS. É a raiz do isolamento de dados.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  User[]
  brands Brand[]

  @@map("tenants")
}

/// Usuário do painel (dono, gerente ou operador de UM tenant).
model User {
  id String @id @default(cuid())

  // ---- isolamento por tenant ----
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name         String
  email        String @unique // ver "pontas soltas": por ora o e-mail é único no sistema inteiro
  passwordHash String
  role         Role   @default(OPERATOR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pedidosLancados Order[]        @relation("PedidosDoGarcom")
  comandas        TableSession[] @relation("ComandasDoGarcom")
  chamadosAtendidos ServiceCall[] @relation("ChamadosAtendidos")

  @@index([tenantId])
  @@map("users")
}

/// A marca (ex.: "Cantina da Nona"). Um tenant pode ter várias.
/// O cardápio, na Etapa 1, vai pendurar aqui.
model Brand {
  id String @id @default(cuid())

  // ---- isolamento por tenant ----
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String
  /// endereço público do cardápio: /m/<slug>
  /// Único no sistema INTEIRO (não só dentro da empresa), porque é um link
  /// que qualquer pessoa acessa sem login.
  slug String @unique

  // white-label básico: a página do cardápio se pinta com isto
  primaryColor String  @default("#E11D48")
  logoUrl      String?
  description  String? // frase curta que aparece no topo do cardápio

  /// Pausar a marca inteira: o cardápio sai do ar na hora e nenhum pedido entra.
  paused       Boolean @default(false)
  pausedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menus        Menu[]
  orders       Order[]
  units        BrandUnit[]
  customers    Customer[]
  deliveryArea DeliveryArea[]
  openingHours OpeningHour[]
  tables       Table[]
  sessions     TableSession[]

  @@index([tenantId])
  @@map("brands")
}

// ===========================================================================
//  CATÁLOGO  (Etapa 1)
//  O cardápio pertence à MARCA e a um CANAL — a mesma marca pode ter preços
//  e itens diferentes no delivery, no salão e no balcão.
// ===========================================================================

/// Canal de venda.
enum SalesChannel {
  DELIVERY // entrega
  DINE_IN // salão
  COUNTER // balcão / retirada
}

/// O cardápio de uma marca em um canal.
model Menu {
  id String @id @default(cuid())

  tenantId String
  brandId  String
  brand    Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  channel  SalesChannel

  name   String
  active Boolean @default(true)

  categories Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, channel])
  @@index([tenantId])
  @@map("menus")
}

/// Seção do cardápio: "Entradas", "Massas", "Bebidas"...
model Category {
  id String @id @default(cuid())

  tenantId String
  menuId   String
  menu     Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  items Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([menuId])
  @@map("categories")
}

/// Um produto do cardápio.
model Item {
  id String @id @default(cuid())

  tenantId   String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name        String
  description String?
  /// SEMPRE em centavos. Nunca usamos número com vírgula para dinheiro.
  priceCents  Int
  imageUrl    String?
  sortOrder   Int     @default(0)
  /// "pausar item" — some do cardápio sem ser apagado
  active      Boolean @default(true)

  /// Para qual estação da cozinha este item vai (chapa, montagem, bebidas...).
  /// Vazio = cai na estação padrão.
  stationId String?
  station   Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]
  unitOverrides  UnitItemOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([categoryId])
  @@map("items")
}

/// Grupo de complementos de um item: "Ponto da carne", "Adicionais"...
model ModifierGroup {
  id String @id @default(cuid())

  tenantId String
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  name String
  /// quantas opções o cliente PRECISA escolher (0 = opcional)
  minSelect Int @default(0)
  /// quantas ele PODE escolher no máximo
  maxSelect Int @default(1)
  sortOrder Int @default(0)

  modifiers Modifier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([itemId])
  @@map("modifier_groups")
}

/// Uma opção dentro do grupo: "Bem passado", "Bacon extra +R$ 6,00"...
model Modifier {
  id String @id @default(cuid())

  tenantId String
  groupId  String
  group    ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name String
  /// quanto SOMA ao preço do item (em centavos; pode ser 0)
  priceDeltaCents Int     @default(0)
  sortOrder       Int     @default(0)
  active          Boolean @default(true)

  orderItemModifiers OrderItemModifier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([groupId])
  @@map("modifiers")
}

// ===========================================================================
//  PEDIDO  (Etapa 1)
// ===========================================================================

/// De onde o pedido veio. É isto que decide se há comissão do portal.
enum OrderSource {
  DIRECT // canal próprio do restaurante — SEM comissão
  PORTAL // veio do nosso marketplace — COM comissão embutida
  IFOOD // importado do iFood
}

/// Os estados por que um pedido passa.
enum OrderStatus {
  AWAITING_PAYMENT // aguardando pagamento
  RECEIVED // recebido (caiu na cozinha)
  ACCEPTED // aceito
  IN_PREPARATION // em preparo
  READY // pronto
  OUT_FOR_DELIVERY // saiu para entrega
  DELIVERED // entregue
  CANCELED // cancelado
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CARD
  CASH
}

model Order {
  id String @id @default(cuid())

  tenantId String
  brandId  String
  brand    Brand        @relation(fields: [brandId], references: [id])
  channel  SalesChannel @default(DELIVERY)
  source   OrderSource  @default(DIRECT)

  /// Em qual loja/cozinha este pedido é produzido.
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  /// Cliente da MARCA (a base é de cada marca, nunca compartilhada).
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // ---- salão (Etapa 3) ----
  /// Em qual mesa este pedido foi feito.
  tableId String?
  table   Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  /// A comanda da mesa — junta as várias rodadas de pedido numa conta só.
  tableSessionId String?
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  /// Qual garçom lançou (vazio = o próprio cliente pediu pelo QR ou totem).
  waiterId String?
  waiter   User?   @relation("PedidosDoGarcom", fields: [waiterId], references: [id], onDelete: SetNull)

  /// código curto que o cliente usa para acompanhar (ex.: "A7K2QD")
  code String @unique

  status OrderStatus @default(AWAITING_PAYMENT)

  // ---- cliente (sem cadastro: só o necessário para entregar) ----
  customerName    String
  customerPhone   String
  addressStreet   String?
  addressNumber   String?
  addressDistrict String?
  addressCity     String?
  addressNote     String?

  /// pedido agendado para depois (null = "para agora")
  scheduledFor DateTime?

  // ---- dinheiro, sempre em centavos ----
  subtotalCents    Int @default(0)
  deliveryFeeCents Int @default(0)
  totalCents       Int @default(0)

  notes String?

  items   OrderItem[]
  events  OrderEvent[]
  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([brandId, status])
  @@index([tenantId, createdAt])
  @@map("orders")
}

/// Uma linha do pedido.
/// Guardamos CÓPIA do nome e do preço: se o cardápio mudar amanhã,
/// o pedido de hoje continua contando a história certa.
model OrderItem {
  id String @id @default(cuid())

  tenantId String
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  /// Para qual estação da cozinha esta linha vai.
  /// Guardamos CÓPIA do nome: se a estação for renomeada ou apagada amanhã,
  /// a comanda de hoje continua legível.
  stationId           String?
  station             Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  stationNameSnapshot String?

  nameSnapshot   String
  unitPriceCents Int
  quantity       Int @default(1)
  /// (preço do item + complementos) x quantidade
  totalCents     Int

  notes String?

  modifiers OrderItemModifier[]

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id String @id @default(cuid())

  tenantId    String
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  modifierId String?
  modifier   Modifier? @relation(fields: [modifierId], references: [id], onDelete: SetNull)

  nameSnapshot    String
  priceDeltaCents Int

  @@index([tenantId])
  @@index([orderItemId])
  @@map("order_item_modifiers")
}

/// Histórico de eventos de domínio do pedido.
/// Cada mudança de estado grava uma linha aqui — é a "certidão de nascimento"
/// do pedido e a base para o KDS, o rastreio e, mais pra frente, o BI.
model OrderEvent {
  id String @id @default(cuid())

  tenantId String
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// ex.: "order.created", "order.status_changed", "order.paid"
  type String
  /// detalhes livres (status anterior, quem mudou, etc.)
  payload Json?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([orderId, createdAt])
  @@map("order_events")
}

/// A cobrança do pedido, criada pelo PaymentProvider.
model Payment {
  id String @id @default(cuid())

  tenantId String

  /// Um pagamento pertence a UM pedido (delivery) OU a UMA comanda de mesa.
  /// Na mesa pode haver vários — é assim que a conta é dividida.
  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  tableSessionId String?
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)

  /// qual adaptador gerou (hoje: "fake-pix")
  provider   String
  externalId String        @unique
  method     PaymentMethod @default(PIX)
  status     PaymentStatus @default(PENDING)
  amountCents Int

  /// Pix: o "copia e cola" e a imagem do QR
  qrCode      String?
  qrCodeImage String?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tableSessionId])
  @@map("payments")
}

// ===========================================================================
//  SALÃO  (Etapa 3)
// ===========================================================================

enum TableStatus {
  FREE // livre
  OCCUPIED // ocupada
  BILL_REQUESTED // pediu a conta
  RESERVED // reservada
  BLOCKED // bloqueada (manutenção)
}

enum SessionStatus {
  OPEN // comanda aberta, ainda pedindo
  CLOSING // conta fechada, aguardando pagamento
  PAID // quitada
  CANCELED
}

enum ServiceCallType {
  WAITER // chamar garçom
  BILL // pedir a conta
}

enum ServiceCallStatus {
  PENDING
  DONE
}

enum ReservationStatus {
  CONFIRMED
  SEATED
  CANCELED
  NO_SHOW
}

enum WaitlistStatus {
  WAITING
  CALLED
  SEATED
  GAVE_UP
}

/// Uma mesa do salão.
/// Pertence a UMA marca — é assim que o QR sabe qual cardápio abrir.
model Table {
  id String @id @default(cuid())

  tenantId String
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  brandId  String
  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  /// o que está escrito na mesa: "5", "V2"
  number String
  area   String @default("Salão")
  seats  Int    @default(4)

  /// posição no mapa de mesas (grade simples)
  posX Int @default(0)
  posY Int @default(0)

  /// o que vai dentro do QR Code: /mesa/<qrToken>
  qrToken String      @unique
  status  TableStatus @default(FREE)
  active  Boolean     @default(true)

  sessions     TableSession[]
  orders       Order[]
  calls        ServiceCall[]
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, number])
  @@index([tenantId])
  @@map("tables")
}

/// A COMANDA DA MESA — o coração do salão.
///
/// Abre quando alguém senta e fecha quando a conta é paga. Junta as várias
/// rodadas de pedido (entrada, prato, sobremesa) numa conta só.
model TableSession {
  id String @id @default(cuid())

  tenantId String
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tableId  String
  table    Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  brandId  String
  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  /// código curto que o cliente vê na tela do celular
  code   String        @unique
  status SessionStatus @default(OPEN)
  guests Int           @default(1)

  /// garçom responsável (vazio quando o cliente pediu sozinho pelo QR)
  waiterId String?
  waiter   User?   @relation("ComandasDoGarcom", fields: [waiterId], references: [id], onDelete: SetNull)

  /// taxa de serviço: 1000 = 10%. Pode ser desligada pelo cliente.
  serviceFeeBps     Int     @default(1000)
  serviceFeeEnabled Boolean @default(true)

  // ---- valores, sempre em centavos ----
  subtotalCents   Int @default(0)
  serviceFeeCents Int @default(0)
  totalCents      Int @default(0)
  /// quanto já entrou (a conta pode ser paga em partes)
  paidCents       Int @default(0)

  notes String?

  openedAt DateTime  @default(now())
  closedAt DateTime?

  orders   Order[]
  payments Payment[]
  calls    ServiceCall[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tableId, status])
  @@map("table_sessions")
}

/// "Chamar garçom" e "pedir a conta".
model ServiceCall {
  id String @id @default(cuid())

  tenantId String
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tableId  String
  table    Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  sessionId String?
  session   TableSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  type   ServiceCallType
  status ServiceCallStatus @default(PENDING)
  note   String?

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("ChamadosAtendidos", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([unitId, status])
  @@map("service_calls")
}

/// Reserva de mesa.
model Reservation {
  id String @id @default(cuid())

  tenantId String
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tableId  String?
  table    Table? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  name   String
  phone  String
  guests Int    @default(2)
  /// quando o cliente chega
  when   DateTime
  status ReservationStatus @default(CONFIRMED)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([unitId, when])
  @@map("reservations")
}

/// Fila de espera (quando não há mesa livre).
model WaitlistEntry {
  id String @id @default(cuid())

  tenantId String
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  name   String
  phone  String
  guests Int            @default(2)
  status WaitlistStatus @default(WAITING)

  calledAt DateTime?
  seatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([unitId, status])
  @@map("waitlist")
}

// ===========================================================================
//  MULTIMARCA, MULTICANAL E MULTIUNIDADE  (Etapa 2)
// ===========================================================================

/// A loja física: onde a comida é produzida. Tem CNPJ próprio.
/// Uma dark kitchen é UMA unidade com VÁRIAS marcas dentro.
model Unit {
  id String @id @default(cuid())

  tenantId String

  name String
  cnpj String?

  addressStreet   String?
  addressNumber   String?
  addressDistrict String?
  addressCity     String?

  /// Coordenadas — é daqui que sai a conta de distância para o frete por raio.
  latitude  Float?
  longitude Float?

  active Boolean @default(true)

  /// Taxa de serviço padrão do salão, em pontos-base (1000 = 10%).
  serviceFeeBps Int @default(1000)

  brands    BrandUnit[]
  stations  Station[]
  orders    Order[]
  overrides UnitItemOverride[]
  tables    Table[]
  sessions  TableSession[]
  calls     ServiceCall[]
  reservations Reservation[]
  waitlist  WaitlistEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("units")
}

/// Quais marcas operam em quais unidades.
model BrandUnit {
  id String @id @default(cuid())

  tenantId String
  brandId  String
  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  active Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([brandId, unitId])
  @@index([tenantId])
  @@map("brand_units")
}

/// Estação de produção dentro de uma unidade: Chapa, Montagem, Forno, Bebidas.
/// É o que faz o KDS mandar cada item para a tela certa.
model Station {
  id String @id @default(cuid())

  tenantId String
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  items      Item[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([unitId])
  @@map("stations")
}

/// A EXCEÇÃO LOCAL do cardápio central.
///
/// O cardápio é da marca — você edita uma vez e vale para todas as unidades.
/// Esta tabela existe só para o caso "nesta loja acabou o camarão hoje" ou
/// "nesta loja o preço é outro". É exceção, não regra.
model UnitItemOverride {
  id String @id @default(cuid())

  tenantId String
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// pausado só nesta unidade
  paused Boolean @default(false)
  /// preço diferente só nesta unidade (vazio = usa o preço da marca)
  priceCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, itemId])
  @@index([tenantId])
  @@map("unit_item_overrides")
}

/// Cliente de uma MARCA.
///
/// Princípio "seus clientes, seus dados": a base é por marca. O mesmo telefone
/// pedindo na Cantina e na Burger vira dois cadastros — são negócios distintos.
model Customer {
  id String @id @default(cuid())

  tenantId String
  brandId  String
  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name  String
  phone String

  /// resumo, para o CRM não precisar somar pedido por pedido
  ordersCount     Int       @default(0)
  totalSpentCents Int       @default(0)
  lastOrderAt     DateTime?

  /// último endereço usado — poupa o cliente de redigitar
  addressStreet   String?
  addressNumber   String?
  addressDistrict String?
  addressCity     String?
  addressNote     String?

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, phone])
  @@index([tenantId])
  @@map("customers")
}

/// De que jeito a marca define para onde entrega.
enum DeliveryAreaKind {
  DISTRICT // por bairro: cada bairro tem seu frete
  RADIUS // por distância: faixas de km
}

/// Uma regra de área de entrega. A marca usa um dos dois jeitos.
model DeliveryArea {
  id String @id @default(cuid())

  tenantId String
  brandId  String       @map("brandId")
  brand    Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  channel  SalesChannel @default(DELIVERY)

  kind DeliveryAreaKind

  /// quando kind = DISTRICT
  districtName String?
  /// quando kind = RADIUS: vale até esta distância (em km)
  maxDistanceKm Float?

  feeCents      Int
  /// pedido mínimo para esta área (0 = sem mínimo)
  minOrderCents Int     @default(0)
  active        Boolean @default(true)
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([brandId, channel])
  @@map("delivery_areas")
}

/// Horário de funcionamento por marca e canal.
/// Uma marca pode abrir só à noite no delivery e o dia todo no balcão.
model OpeningHour {
  id String @id @default(cuid())

  tenantId String
  brandId  String
  brand    Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  channel  SalesChannel @default(DELIVERY)

  /// 0 = domingo, 1 = segunda, ... 6 = sábado
  weekday Int
  /// minutos desde a meia-noite (ex.: 11h30 = 690). Evita fuso e formato de hora.
  opensAtMinutes  Int
  closesAtMinutes Int

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([brandId, channel, weekday])
  @@map("opening_hours")
}

/// Avisos de gateway já processados — garante IDEMPOTÊNCIA.
/// Se o mesmo aviso chegar duas vezes, a segunda é ignorada.
model ProcessedWebhook {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@map("processed_webhooks")
}
