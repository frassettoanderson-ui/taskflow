# Access Token do Mercado Pago (produção começa com APP_USR-, teste com TEST-)
MP_ACCESS_TOKEN=
# Base pública do site (usada em back_urls do cartão e no webhook)
PUBLIC_BASE=https://abarimigreja.com.br/diamond
# Chave do painel: /diamond/painel/?key=...
ADMIN_KEY=troque-esta-senha
# Link do grupo de WhatsApp das inscritas (criado no WhatsApp da pastora)
GRUPO_WHATSAPP=
# Valor da inscrição em reais (PIX cobra exatamente este valor)
VALOR=30.00
# Parcelas no cartão (1 = à vista)
MAX_PARCELAS=1
# Taxa do cartão do Mercado Pago (0.0498 = 4,98%) — repassada INTEIRA ao cliente
TAXA_CARTAO=0.0498
PORT=8403
# Evolution API (WhatsApp) — instância pareada no celular da PASTORA
EVOLUTION_URL=http://127.0.0.1:8081
EVOLUTION_KEY=
EVOLUTION_INSTANCE=diamond
# opcional: JID do grupo (descoberto sozinho pelo link do convite)
GRUPO_JID=
