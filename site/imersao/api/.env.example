# Access Token do Mercado Pago (produção começa com APP_USR-, teste com TEST-)
MP_ACCESS_TOKEN=
# Base pública do site (usada em back_urls do cartão e no webhook)
PUBLIC_BASE=https://abarimigreja.com.br/imersao
# Senha simples do painel de inscritos: /imersao/api/admin?key=...
ADMIN_KEY=troque-esta-senha
# Link do grupo de WhatsApp entregue após o pagamento
GRUPO_WHATSAPP=
# Valor da inscrição em reais (PIX cobra este valor)
VALOR=89.90
# Máximo de parcelas no cartão
MAX_PARCELAS=3
# Taxa do cartão do Mercado Pago (0.0499 = 4,99%) — repassada ao cliente no cartão
TAXA_CARTAO=0.0499
PORT=8402
