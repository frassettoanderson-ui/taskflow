// ============================================================
// GestorOA - Schema Prisma
// Modulo 0: Fundacao, Auth e Tenant
// (estendido incrementalmente a cada modulo)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// TENANT
// ------------------------------------------------------------
model Escritorio {
  id          String   @id @default(cuid())
  nome        String
  cnpj        String?
  logoUrl     String?
  // Configuracoes diversas em JSON: { mailFromName, smtp:{host,port,...}, sabadoEhUtil, ... }
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  usuarios            Usuario[]
  sessoes             Sessao[]
  passwordResets      PasswordResetToken[]
  logsAuditoria       LogAuditoria[]
  empresas            Empresa[]
  departamentos       Departamento[]
  tags                Tag[]
  obrigacoes          Obrigacao[]
  regimes             RegimeTributario[]
  grupos             GrupoObrigacoes[]
  feriados            Feriado[]
  entregas            Entrega[]
  documentos          DocumentoGED[]
  protocolos          Protocolo[]
  protocolosFisicos   ProtocoloFisico[]
  assinaturas         AssinaturaDocumento[]
  roboJobs            RoboJob[]
  matrizes            MatrizProcesso[]
  processos           Processo[]
  processosRecorrentes ProcessoRecorrente[]
  comunicados         Comunicado[]
  solicitacoes        SolicitacaoPortal[]
  templates           TemplateEmail[]
  comunicacoes        ComunicacaoLog[]
  chatbots            ChatbotFluxo[]
  solicitacoesInternas SolicitacaoInterna[]
  dashboards          DashboardConfig[]
  notificacoes        Notificacao[]
  jobExecucoes        JobExecucao[]
  motivosCancelamento MotivoCancelamento[]
  gruposEmpresa       GrupoEmpresa[]

  @@index([deletedAt])
}

// ------------------------------------------------------------
// USUARIOS internos do escritorio
// ------------------------------------------------------------
model Usuario {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])

  nome          String
  email         String
  senhaHash     String
  ativo         Boolean  @default(true)

  // Funcao/cargo exibido entre colchetes na listagem (ex.: Contador socio, Auxiliar).
  tipo          String?  @default("Auxiliar")
  telefone      String?
  observacoes   String?

  // Configuracao de custo e capacidade do colaborador (alimenta o Metodo APLA).
  custoHora       Decimal? @db.Decimal(12, 2)
  minutosUteisMes Int?
  salario         Decimal? @db.Decimal(12, 2)
  encargos        Decimal? @db.Decimal(12, 2)
  beneficios      Decimal? @db.Decimal(12, 2)

  // Dados de e-mail (SMTP por usuario) + assinatura + copia oculta
  smtpHost        String?
  smtpPorta       Int?
  smtpUsuario     String?
  smtpSenha       String?
  ccoEmails       String?
  assinaturaArquivo String?
  fotoPerfilArquivo String?
  notifSolicitacoesEmail Boolean @default(true)
  notifMarketingEmail    Boolean @default(true)
  painelPreferidoId String?  // Dashboard Flexivel: painel exibido ao iniciar

  // Janelas de acesso permitidas: [{ diaSemana, inicio, fim }]. Vazio = sem restricao.
  horariosAcesso Json    @default("[]")

  // Filtros forcados (Modulo 4): { departamentos: string[], tags: string[] }. {} = sem restricao.
  filtrosForcados Json   @default("{}")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  permissao     Permissao?
  sessoes       Sessao[]
  logsAuditoria LogAuditoria[]
  notificacoes  Notificacao[]

  @@unique([escritorioId, email])
  @@index([escritorioId, deletedAt])
}

// ------------------------------------------------------------
// PERMISSOES (RBAC granular por flags) - 1:1 com Usuario
// ------------------------------------------------------------
model Permissao {
  id        String  @id @default(cuid())
  usuarioId String  @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // Niveis escolhidos por area (estilo Acessorias). As flags abaixo sao derivadas.
  niveis    Json    @default("{}")

  empresas_ver              Boolean @default(false)
  empresas_criar            Boolean @default(false)
  empresas_editar           Boolean @default(false)
  empresas_excluir          Boolean @default(false)
  empresas_importar         Boolean @default(false)

  obrigacoes_ver            Boolean @default(false)
  obrigacoes_gerenciar      Boolean @default(false)

  entregas_ver              Boolean @default(false)
  entregas_baixar           Boolean @default(false)
  entregas_editar_prazos    Boolean @default(false)
  entregas_acoes_massa      Boolean @default(false)
  entregas_desfazer_robo    Boolean @default(false)
  entregas_dispensar        Boolean @default(false)

  processos_ver             Boolean @default(false)
  processos_gerenciar_matrizes Boolean @default(false)
  processos_operar          Boolean @default(false)

  documentos_ver            Boolean @default(false)
  documentos_upload         Boolean @default(false)
  documentos_excluir        Boolean @default(false)

  relatorios_ver            Boolean @default(false)

  apla_ver                  Boolean @default(false)
  apla_configurar           Boolean @default(false)

  portal_comunicados        Boolean @default(false)
  portal_solicitacoes       Boolean @default(false)
  portal_configurar         Boolean @default(false)

  solicitacoes_internas_ver       Boolean @default(false)
  solicitacoes_internas_gerenciar Boolean @default(false)

  admin_usuarios            Boolean @default(false)
  admin_permissoes          Boolean @default(false)
  admin_transferir_resp     Boolean @default(false)
  admin_auditoria           Boolean @default(false)
  admin_escritorio          Boolean @default(false)
}

// ------------------------------------------------------------
// SESSOES (refresh tokens) - rotacao a cada refresh
// ------------------------------------------------------------
model Sessao {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  usuarioId     String
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])

  // hash do refresh token (nunca armazenar o token em claro)
  tokenHash     String   @unique
  userAgent     String?
  ip            String?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([usuarioId])
}

// ------------------------------------------------------------
// RECUPERACAO DE SENHA
// ------------------------------------------------------------
model PasswordResetToken {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  usuarioId     String
  tokenHash     String   @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([usuarioId])
}

// ------------------------------------------------------------
// AUDITORIA
// ------------------------------------------------------------
model LogAuditoria {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  usuarioId     String?
  usuario       Usuario? @relation(fields: [usuarioId], references: [id])

  acao          String   // CREATE | UPDATE | DELETE
  entidade      String   // nome do model
  entidadeId    String?
  antes         Json?
  depois        Json?
  createdAt     DateTime @default(now())

  @@index([escritorioId, entidade, createdAt])
  @@index([escritorioId, usuarioId])
}

// ============================================================
// MODULO 1 - Departamentos e Cadastro de Empresas
// ============================================================

enum TipoIdentificador {
  CNPJ
  CPF
  INSCRICAO_ESTADUAL
  CEI
  CAEPF
}

model Departamento {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  nome          String
  cor           String   @default("#0f5c5e")
  responsavelId String?  // responsavel padrao (= primeiro gestor)
  gestoresIds   Json     @default("[]") // usuarios gestores do departamento (varios)
  ativo         Boolean  @default(true)
  parentId      String?  // departamento pai (hierarquia)
  envioAgendado String   @default("De hora em hora") // periodicidade do envio agrupado/agendado
  disponivelSolicitacoes Boolean @default(true)        // aparece em novas Solicitacoes (Area VIP)
  responderPara String?  // endereco "Responder para" dos e-mails do depto
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent        Departamento?  @relation("DepHierarquia", fields: [parentId], references: [id], onDelete: SetNull)
  filhos        Departamento[] @relation("DepHierarquia")
  responsaveis  EmpresaResponsavelDepartamento[]
  comentarios   EmpresaComentario[]
  obrigacoes    Obrigacao[]

  @@unique([escritorioId, nome])
  @@index([escritorioId])
}

model Tag {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  nome          String
  cor           String   @default("#64748b")
  createdAt     DateTime @default(now())

  empresas      EmpresaTag[]

  @@unique([escritorioId, nome])
  @@index([escritorioId])
}

model Empresa {
  id                 String   @id @default(cuid())
  escritorioId       String
  escritorio         Escritorio @relation(fields: [escritorioId], references: [id])

  razaoSocial        String
  nomeFantasia       String?
  numero             Int?               // [ID] sequencial por escritorio (max 5 digitos)
  honorario          Decimal?           @db.Decimal(12, 2)
  apelidoEcontinuo   String?            // nome usado na pasta de backup do e-Continuo
  emailPrincipal     String?
  telefone           String?
  endereco           String?            // legado (endereco em texto livre)
  cep                String?
  logradouro         String?
  numeroEndereco     String?
  complemento        String?
  bairro             String?
  cidade             String?
  uf                 String?
  grupoEnvio         String?            // grupo de envio de e-mails (lote)
  regimeTributarioId String?
  regimeTributario   RegimeTributario? @relation(fields: [regimeTributarioId], references: [id])
  motivoCancelamentoId String?
  motivoCancelamento MotivoCancelamento? @relation(fields: [motivoCancelamentoId], references: [id])
  grupoEmpresaId     String?
  grupoEmpresa       GrupoEmpresa? @relation(fields: [grupoEmpresaId], references: [id])
  anotacoes          String?
  ativo              Boolean  @default(true)
  dataEntrada        DateTime?
  dataSaida          DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  identificadores    EmpresaIdentificador[]
  contatos           EmpresaContato[]
  anexos             EmpresaAnexo[]
  comentarios        EmpresaComentario[]
  responsaveis       EmpresaResponsavelDepartamento[]
  tags               EmpresaTag[]
  obrigacoes         EmpresaObrigacao[]
  entregas           Entrega[]
  documentos         DocumentoGED[]
  protocolos         Protocolo[]
  protocolosFisicos  ProtocoloFisico[]
  processos          Processo[]
  solicitacoes       SolicitacaoPortal[]
  comunicacoes       ComunicacaoLog[]
  tarefasAgendadas   EmpresaTarefaAgendada[]

  @@index([escritorioId, deletedAt])
  @@index([escritorioId, ativo])
}

model EmpresaTarefaAgendada {
  id            String   @id @default(cuid())
  escritorioId  String
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  titulo        String
  descricao     String?
  dataHora      DateTime
  concluida     Boolean  @default(false)
  concluidaEm   DateTime?
  autorId       String?
  createdAt     DateTime @default(now())

  @@index([empresaId])
  @@index([escritorioId, dataHora])
}

model EmpresaTag {
  empresaId  String
  empresa    Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([empresaId, tagId])
  @@index([tagId])
}

model GrupoEmpresa {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  nome          String
  createdAt     DateTime @default(now())
  empresas      Empresa[]

  @@index([escritorioId])
}

model MotivoCancelamento {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  nome          String
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  empresas      Empresa[]

  @@unique([escritorioId, nome])
  @@index([escritorioId])
}

model EmpresaIdentificador {
  id            String   @id @default(cuid())
  escritorioId  String
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  tipo          TipoIdentificador
  // valor normalizado (apenas digitos)
  valor         String
  apelido       String?
  createdAt     DateTime @default(now())

  @@unique([escritorioId, tipo, valor])
  @@index([empresaId])
  // indice usado pelo robo (Modulo 5) para matching por valor
  @@index([escritorioId, valor])
}

model EmpresaResponsavelDepartamento {
  id              String   @id @default(cuid())
  escritorioId    String
  empresaId       String
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  departamentoId  String
  departamento    Departamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)
  usuarioId       String

  @@unique([empresaId, departamentoId])
  @@index([escritorioId])
  @@index([usuarioId])
}

model EmpresaContato {
  id            String   @id @default(cuid())
  escritorioId  String
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nome          String
  email         String?
  whatsapp      String?
  cargo         String?

  // Permissoes do contato (usadas na Area VIP - Modulo 10):
  // departamentos liberados e, opcionalmente, obrigacoes especificas.
  departamentoIds Json  @default("[]")
  obrigacaoIds    Json  @default("[]")

  // Acesso ao portal (Modulo 10) - preparado, ativado depois
  senhaHash     String?
  ativo         Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([empresaId])
  @@index([escritorioId])
}

model EmpresaAnexo {
  id            String   @id @default(cuid())
  escritorioId  String
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nomeArquivo   String
  caminho       String
  tamanho       Int
  mimeType      String?
  uploadedById  String?
  createdAt     DateTime @default(now())

  @@index([empresaId])
}

// ============================================================
// MODULO 2 - Obrigacoes, Regimes Tributarios e Grupos
// ============================================================

enum Periodicidade {
  MENSAL
  TRIMESTRAL
  ANUAL
  EVENTUAL
}

enum OrigemObrigacao {
  REGIME
  GRUPO
  MANUAL
}

model Feriado {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  data          DateTime @db.Date
  nome          String
  abrangencia   String   @default("NACIONAL") // NACIONAL | ESTADUAL | MUNICIPAL
  uf            String?
  municipio     String?
  createdAt     DateTime @default(now())

  @@unique([escritorioId, data, nome])
  @@index([escritorioId, data])
}

model Obrigacao {
  id                 String   @id @default(cuid())
  escritorioId       String
  escritorio         Escritorio @relation(fields: [escritorioId], references: [id])

  nome               String
  mininome           String?
  departamentoId     String?
  departamento       Departamento? @relation(fields: [departamentoId], references: [id])
  responsavelId      String?
  descricao          String?
  periodicidade      Periodicidade @default(MENSAL)
  // Regra de prazo (JSON): { tipoDia, dia, regraNaoUtil, sabadoEhUtil, diasAntesTecnico, tipoDiasAntes }
  regraPrazo         Json     @default("{}")
  // Entrega mes a mes (JSON): 12 itens [{ modo: NAO_ENTREGA|DIA_FIXO|DIA_UTIL|ULT_DIA_UTIL, dia? }]
  entregaMeses       Json     @default("[]")
  tempoPrevistoMin   Int      @default(0)
  lembrarDiasAntes   Int      @default(5)
  // Competencia de referencia: MES_ATUAL | MES_ANTERIOR | ANO_ATUAL | ANO_ANTERIOR
  competenciaRef     String   @default("MES_ANTERIOR")
  exigeAnexoNaBaixa  Boolean  @default(false)
  exigeBaixaPeloRobo Boolean  @default(false)
  passivelMulta      Boolean  @default(false)
  alertaNaoLida      Boolean  @default(true)
  comentarioPadrao   String?
  ativo              Boolean  @default(true)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  regimes            RegimeObrigacao[]
  grupos             GrupoObrigacao[]
  empresaObrigacoes  EmpresaObrigacao[]
  entregas           Entrega[]

  @@index([escritorioId, deletedAt])
  @@index([escritorioId, departamentoId])
}

model RegimeTributario {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  nome          String
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  obrigacoes    RegimeObrigacao[]
  empresas      Empresa[]

  @@unique([escritorioId, nome])
  @@index([escritorioId])
}

model RegimeObrigacao {
  id            String   @id @default(cuid())
  regimeId      String
  regime        RegimeTributario @relation(fields: [regimeId], references: [id], onDelete: Cascade)
  obrigacaoId   String
  obrigacao     Obrigacao @relation(fields: [obrigacaoId], references: [id], onDelete: Cascade)
  // override opcional de tempo previsto por regime
  tempoPrevistoOverride Int?

  @@unique([regimeId, obrigacaoId])
  @@index([obrigacaoId])
}

model GrupoObrigacoes {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  nome          String
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  obrigacoes    GrupoObrigacao[]

  @@unique([escritorioId, nome])
  @@index([escritorioId])
}

model GrupoObrigacao {
  id            String   @id @default(cuid())
  grupoId       String
  grupo         GrupoObrigacoes @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  obrigacaoId   String
  obrigacao     Obrigacao @relation(fields: [obrigacaoId], references: [id], onDelete: Cascade)

  @@unique([grupoId, obrigacaoId])
  @@index([obrigacaoId])
}

// Vinculo efetivo empresa x obrigacao. Uma linha por par; as ORIGENS
// (regime/grupo/manual) ficam em JSON para suportar a semantica:
// regime SUBSTITUI as origens REGIME; grupo so' ADICIONA; remover grupo
// tira a origem GRUPO e, se ficar sem origens, inativa.
model EmpresaObrigacao {
  id            String   @id @default(cuid())
  escritorioId  String
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  obrigacaoId   String
  obrigacao     Obrigacao @relation(fields: [obrigacaoId], references: [id], onDelete: Cascade)

  // origens: [{ origem: "REGIME"|"GRUPO"|"MANUAL", refId?: string }]
  origens       Json     @default("[]")
  ativo         Boolean  @default(true)

  // overrides opcionais
  responsavelId        String?
  diaPrazoOverride     Int?
  honorario            Decimal? @db.Decimal(12, 2)
  tempoPrevistoOverride Int?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entregas      Entrega[]

  @@unique([empresaId, obrigacaoId])
  @@index([escritorioId])
  @@index([empresaId, ativo])
  @@index([obrigacaoId])
}

// ============================================================
// MODULO 3 - Lista de Entregas e Gestao de Prazos
// ============================================================

enum StatusEntrega {
  PENDENTE
  PENDENTE_ANTECIPADO
  EM_ATRASO_TECNICO
  EM_ATRASO_LEGAL
  ENTREGUE
  ENTREGUE_JUSTIFICADA
  DISPENSADA
}

enum OrigemBaixa {
  MANUAL
  ROBO
}

model Entrega {
  id                  String   @id @default(cuid())
  escritorioId        String
  escritorio          Escritorio @relation(fields: [escritorioId], references: [id])
  empresaId           String
  empresa             Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaObrigacaoId  String
  empresaObrigacao    EmpresaObrigacao @relation(fields: [empresaObrigacaoId], references: [id], onDelete: Cascade)
  obrigacaoId         String
  obrigacao           Obrigacao @relation(fields: [obrigacaoId], references: [id])

  // competencia (mes/ano de referencia)
  competenciaAno      Int
  competenciaMes      Int      // 1-12

  prazoLegal          DateTime @db.Date
  prazoTecnico        DateTime @db.Date

  status              StatusEntrega @default(PENDENTE)

  responsavelPrazoId   String?
  responsavelEntregaId String?

  dataEntrega         DateTime?
  numeroProtocolo     String?
  vencimentoGuia      DateTime? @db.Date
  justificativa       String?
  motivoDispensa      String?
  origemBaixa         OrigemBaixa?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  anexos              EntregaAnexo[]
  comentarios         EntregaComentario[]
  eventos             EntregaEvento[]

  @@unique([empresaId, obrigacaoId, competenciaAno, competenciaMes])
  @@index([escritorioId, competenciaAno, competenciaMes])
  @@index([escritorioId, status])
  @@index([escritorioId, prazoLegal])
  @@index([responsavelPrazoId])
  @@index([responsavelEntregaId])
  @@index([empresaId])
}

model EntregaAnexo {
  id            String   @id @default(cuid())
  escritorioId  String
  entregaId     String
  entrega       Entrega  @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  nomeArquivo   String
  caminho       String
  tamanho       Int
  mimeType      String?
  createdAt     DateTime @default(now())

  @@index([entregaId])
}

model EntregaComentario {
  id            String   @id @default(cuid())
  escritorioId  String
  entregaId     String
  entrega       Entrega  @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  texto         String
  autorId       String?
  createdAt     DateTime @default(now())

  @@index([entregaId])
}

// Historico de movimentacao da demanda (balaozinho [F2])
model EntregaEvento {
  id            String   @id @default(cuid())
  escritorioId  String
  entregaId     String
  entrega       Entrega  @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  texto         String   // ex: "Mudou status de Pendente para Entregue", "Comentou: ..."
  autorId       String?
  createdAt     DateTime @default(now())

  @@index([entregaId])
}

model EmpresaComentario {
  id              String   @id @default(cuid())
  escritorioId    String
  empresaId       String
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  texto           String
  autorId         String?
  departamentoId  String?
  departamento    Departamento? @relation(fields: [departamentoId], references: [id])
  createdAt       DateTime @default(now())

  @@index([empresaId])
}

// ============================================================
// MODULO 7 - GED + Protocolo Digital e Fisico
// ============================================================

enum OrigemDocumento {
  MANUAL
  ENTREGA
  ROBO
}

enum CanalProtocolo {
  EMAIL
  AREA_VIP
  WHATSAPP
}

enum StatusProtocoloFisico {
  AGUARDANDO_RETIRADA
  ENTREGUE
  DEVOLVIDO
  CANCELADO
  PENDENTE
  IMPRESSO
}

model DocumentoGED {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // raiz fixa: "DocsEmpresa" (manual) ou "DocsEntregas" (automatico)
  raiz          String   @default("DocsEmpresa")
  // subpasta livre, ex.: "Contratos" ou "2026/06/DAS"
  pasta         String   @default("")
  nomeArquivo   String
  caminho       String
  tamanho       Int
  mimeType      String?
  origem        OrigemDocumento @default(MANUAL)
  entregaId     String?
  uploadedById  String?
  createdAt     DateTime @default(now())

  protocolos    Protocolo[]

  @@index([escritorioId, empresaId, raiz])
  @@index([empresaId, nomeArquivo])
}

model Protocolo {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  documentoId   String?
  documento     DocumentoGED? @relation(fields: [documentoId], references: [id], onDelete: SetNull)

  token         String   @unique
  destinatario  String   // nome/email do contato
  contatoId     String?
  canal         CanalProtocolo @default(EMAIL)
  enviadoEm     DateTime @default(now())
  // assunto/prefixo de lembrete usado quando nao lido
  lembreteEnviadoEm DateTime?

  visualizacoes ProtocoloVisualizacao[]

  @@index([escritorioId, empresaId])
  @@index([documentoId])
}

model ProtocoloVisualizacao {
  id            String   @id @default(cuid())
  protocoloId   String
  protocolo     Protocolo @relation(fields: [protocoloId], references: [id], onDelete: Cascade)
  ip            String?
  userAgent     String?
  visualizadoEm DateTime @default(now())

  @@index([protocoloId])
}

model ProtocoloFisico {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  descricao     String
  titulo        String?
  numero        Int?
  retiradoPor   String?
  data          DateTime @default(now())
  dataEntrega   DateTime? @db.Date
  status        StatusProtocoloFisico @default(PENDENTE)
  assinaturaPath String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([escritorioId, empresaId])
}

// ============================================================
// MODULO 5 - Robo de Baixa Automatica (e-Robo)
// ============================================================

enum StatusRoboJob {
  PROCESSANDO
  BAIXADO
  REVISAO
  ERRO
  IGNORADO
}

enum OrigemRoboJob {
  UPLOAD
  WATCHER
  API
}

model AssinaturaDocumento {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  nome          String
  // obrigacao alvo (catalogo) que esta assinatura identifica
  obrigacaoNome String   // casado por nome com a obrigacao da empresa
  // palavras/regex que identificam o tipo (todas devem casar)
  palavras      Json     @default("[]")
  // regex para extrair competencia e vencimento
  regexCompetencia String?
  regexVencimento  String?
  ativo         Boolean  @default(true)
  // Base de conhecimento e-Continuo
  enviaEmail    String   @default("Imediato")    // Imediato | Agendado | Nao
  copiaLocal    Boolean  @default(true)            // mantem copia local (GED)
  aoReenviar    String   @default("Rep.D.A.A.")    // comportamento ao reenviar
  semDemanda    String   @default("Cria")          // quando nao ha demanda correspondente
  exemploArquivo String?                           // PDF de exemplo da guia reconhecida
  miniNomeLocal String?                            // Mini-Nome local (ex.: PRESUMIDO)
  caminhoLocal  String?                            // Caminho local (pastas para salvar)
  anteciparVcto Boolean  @default(true)            // antecipar vcto em dias nao-uteis
  msgAlertaAntecipado String?                      // mensagem de alerta de pagamento antecipado
  consideraVcto Boolean  @default(true)            // considera vcto do documento
  obrigacoesCorrespondentes Json @default("[]")    // obrigacoes correspondentes (varias)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([escritorioId, ativo])
}

model RoboJob {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])

  arquivoNome   String
  caminho       String
  paginaIndex   Int?
  origem        OrigemRoboJob @default(UPLOAD)
  status        StatusRoboJob @default(PROCESSANDO)
  motivo        String?

  // resultado da identificacao
  empresaId         String?
  obrigacaoNome     String?
  competenciaAno    Int?
  competenciaMes    Int?
  entregaId         String?

  // etapas do pipeline: [{ etapa, ok, ms, detalhe }]
  etapas        Json     @default("[]")
  // trecho do texto extraido (para a tela de revisao)
  textoTrecho   String?

  createdAt     DateTime @default(now())
  processadoEm  DateTime?

  @@index([escritorioId, status])
  @@index([escritorioId, createdAt])
}

// ============================================================
// MODULO 6 - Gestao de Processos / Workflows
// ============================================================

enum StatusProcesso {
  EM_ANDAMENTO
  SUSPENSO
  CONCLUIDO
  CANCELADO
}

enum StatusPasso {
  PENDENTE
  CONCLUIDO
  DISPENSADO
}

enum BasePrazoPasso {
  INICIO
  PASSO_ANTERIOR
}

enum AcaoAutomatica {
  NENHUMA
  CRIAR_TAREFA
  CRIAR_OBRIGACAO_NA_EMPRESA
  INICIAR_SUBPROCESSO
}

enum TipoRecorrencia {
  DIAS_MES
  DIAS_SEMANA
  DIAS_UTEIS
}

model MatrizProcesso {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  nome          String
  departamentoId String?
  descricao     String?
  ativo         Boolean  @default(true)
  soSubmatriz   Boolean  @default(false)
  pedeAutorizacao Boolean @default(false)
  barraVermelhaDias Int   @default(45)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  passos        MatrizPasso[]
  processos     Processo[]
  recorrentes   ProcessoRecorrente[]

  @@index([escritorioId])
}

model MatrizPasso {
  id            String   @id @default(cuid())
  matrizId      String
  matriz        MatrizProcesso @relation(fields: [matrizId], references: [id], onDelete: Cascade)
  ordem         Int
  tipo          String   @default("PASSO_SIMPLES") // PASSO_SIMPLES | SUB_MATRIZ | DESDOBRAMENTO | FOLLOW_UP
  titulo        String
  descricao     String?
  departamentoId String?
  prazoDias     Int      @default(0)
  basePrazo     BasePrazoPasso @default(INICIO)
  bloqueante    Boolean  @default(false)
  acaoAutomatica AcaoAutomatica @default(NENHUMA)
  acaoRef       String?  // obrigacaoNome ou matrizId, conforme a acao
  subMatrizId   String?  // alvo quando tipo = SUB_MATRIZ
  config        Json?    // dica / desdobramentos / follow-up

  @@index([matrizId])
}

model Processo {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  matrizId      String?
  matriz        MatrizProcesso? @relation(fields: [matrizId], references: [id])
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nome          String
  numero        Int?
  titulo        String?
  observacoes   String?
  departamentoId String?
  gestorId      String?
  status        StatusProcesso @default(EM_ANDAMENTO)
  dataInicio    DateTime @default(now())
  previsaoConclusao DateTime?
  dataConclusao DateTime?
  suspensoAte   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  passos        ProcessoPasso[]
  comentarios   ProcessoComentario[]

  @@index([escritorioId, status])
  @@index([empresaId])
}

model ProcessoPasso {
  id            String   @id @default(cuid())
  processoId    String
  processo      Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  ordem         Int
  titulo        String
  descricao     String?
  departamentoId String?
  bloqueante    Boolean  @default(false)
  status        StatusPasso @default(PENDENTE)
  prazo         DateTime?
  concluidoEm   DateTime?
  responsavelId String?
  acaoAutomatica AcaoAutomatica @default(NENHUMA)
  acaoRef       String?

  @@index([processoId])
}

model ProcessoComentario {
  id            String   @id @default(cuid())
  processoId    String
  processo      Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  texto         String
  autorId       String?
  createdAt     DateTime @default(now())

  @@index([processoId])
}

model ProcessoRecorrente {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  matrizId      String
  matriz        MatrizProcesso @relation(fields: [matrizId], references: [id], onDelete: Cascade)
  empresaId     String?
  tipoRecorrencia TipoRecorrencia
  config        Json     @default("{}") // { diasMes:[], diasSemana:[] }
  ativo         Boolean  @default(true)
  ultimaExecucao DateTime?
  createdAt     DateTime @default(now())

  @@index([escritorioId, ativo])
}

// ============================================================
// MODULO 10 - Area VIP (Portal do Cliente)
// ============================================================

enum StatusSolicitacao {
  ABERTA
  EM_ANDAMENTO
  FINALIZADA
}

enum AutorTipo {
  CONTATO
  USUARIO
}

model Comunicado {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  titulo        String
  conteudo      String
  tags          Json     @default("[]")   // segmentacao por tag (ids)
  regimes       Json     @default("[]")   // segmentacao por regime (ids)
  publicarEm    DateTime?
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())

  leituras      ComunicadoLeitura[]

  @@index([escritorioId, ativo])
}

model ComunicadoLeitura {
  id            String   @id @default(cuid())
  comunicadoId  String
  comunicado    Comunicado @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  contatoEmail  String
  lidoEm        DateTime @default(now())

  @@unique([comunicadoId, contatoEmail])
}

model SolicitacaoPortal {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contatoEmail  String
  contatoNome   String
  titulo        String
  descricao     String
  status        StatusSolicitacao @default(ABERTA)
  prazo         DateTime?
  avaliacaoNota Int?
  avaliacaoComentario String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mensagens     SolicitacaoMensagem[]

  @@index([escritorioId, status])
  @@index([empresaId])
}

model SolicitacaoMensagem {
  id            String   @id @default(cuid())
  solicitacaoId String
  solicitacao   SolicitacaoPortal @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  autorTipo     AutorTipo
  autorNome     String
  texto         String
  createdAt     DateTime @default(now())

  @@index([solicitacaoId])
}

model AceiteLGPD {
  id            String   @id @default(cuid())
  escritorioId  String
  contatoEmail  String
  versao        String
  ip            String?
  aceitoEm      DateTime @default(now())

  @@index([escritorioId, contatoEmail])
}

model ContatoToken {
  id            String   @id @default(cuid())
  escritorioId  String
  contatoEmail  String
  tokenHash     String   @unique
  tipo          String   @default("CONVITE") // CONVITE | RESET
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([contatoEmail])
}

// ============================================================
// MODULO 8 - Comunicacao (E-mail e WhatsApp)
// ============================================================

enum TipoTemplate {
  ENTREGA
  LEMBRETE
  COMUNICADO
  GENERICO
}

enum CanalComunicacao {
  EMAIL
  WHATSAPP
}

enum StatusComunicacao {
  FILA
  ENVIADO
  FALHOU
  LIDO
  INTENCAO
}

model TemplateEmail {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  tipo          TipoTemplate @default(GENERICO)
  nome          String
  assunto       String
  corpo         String
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([escritorioId, tipo])
}

model ComunicacaoLog {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  empresaId     String?
  empresa       Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  canal         CanalComunicacao
  destinatario  String
  assunto       String?
  conteudo      String?
  status        StatusComunicacao @default(FILA)
  tentativas    Int      @default(0)
  responsavelId String?
  protocoloId   String?
  loteId        String?
  erro          String?
  createdAt     DateTime @default(now())
  enviadoEm     DateTime?

  @@index([escritorioId, createdAt])
  @@index([empresaId])
  @@index([loteId])
}

model ChatbotFluxo {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  nome          String
  arvore        Json     @default("{}")
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([escritorioId])
}

// ============================================================
// MODULO 11 - Solicitacoes Internas (tickets entre setores)
// ============================================================

enum PrioridadeSolicitacao {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum StatusSolicitacaoInterna {
  ABERTA
  EM_ANDAMENTO
  AGUARDANDO
  RESOLVIDA
  CANCELADA
}

model SolicitacaoInterna {
  id              String   @id @default(cuid())
  escritorioId    String
  escritorio      Escritorio @relation(fields: [escritorioId], references: [id])

  titulo          String
  descricao       String
  categoria       String?
  prioridade      PrioridadeSolicitacao @default(MEDIA)
  status          StatusSolicitacaoInterna @default(ABERTA)

  // quem abriu (usuario interno)
  solicitanteId   String
  // setor de destino e responsavel designado (usuario)
  departamentoDestinoId String?
  responsavelId   String?
  // vinculos opcionais (mantidos como IDs simples, sem relacao reversa)
  empresaId       String?
  processoId      String?

  prazo           DateTime?
  resolvidoEm     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mensagens       SolicitacaoInternaMensagem[]

  @@index([escritorioId, status])
  @@index([escritorioId, departamentoDestinoId])
  @@index([responsavelId])
  @@index([solicitanteId])
}

model SolicitacaoInternaMensagem {
  id            String   @id @default(cuid())
  solicitacaoId String
  solicitacao   SolicitacaoInterna @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  autorId       String?
  autorNome     String
  texto         String
  // mudanca de status registrada como evento do thread
  evento        String?
  createdAt     DateTime @default(now())

  @@index([solicitacaoId])
}

// ============================================================
// MODULO 12 - Tela de Insights (dashboard configuravel por usuario)
// ============================================================

model DashboardConfig {
  id            String   @id @default(cuid())
  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id])
  usuarioId     String   @unique
  // layout: [{ id, tipo, w }] - ordem e largura dos widgets escolhidos
  layout        Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([escritorioId])
}

// ------------------------------------------------------------
// Dashboard Flexivel: Indicadores + Paineis (carrossel)
// ------------------------------------------------------------
model Indicador {
  id            String   @id @default(cuid())
  escritorioId  String
  nome          String
  // tipo: numerico | colaborador | departamento
  tipo          String   @default("numerico")
  // metrica calculada (ex.: entregas_baixadas, a_realizar, atrasadas, pendentes, processos, docs, solicitacoes)
  metrica       String
  // prazo/janela: 7d | 30d | semana_atual | mes_atual
  prazo         String   @default("mes_atual")
  // visibilidade: todos | somente_meu
  visibilidade  String   @default("todos")
  ativo         Boolean  @default(true)
  criadoPorId   String?
  // filtros fixos opcionais
  filtroDepartamentoId String?
  filtroGrupoId        String?
  filtroRegimeId       String?
  createdAt     DateTime @default(now())

  paineis       PainelIndicador[]

  @@index([escritorioId])
}

model Painel {
  id            String   @id @default(cuid())
  escritorioId  String
  nome          String
  transicaoSeg  Int      @default(60)
  visibilidade  String   @default("todos")
  ativo         Boolean  @default(true)
  criadoPorId   String?
  createdAt     DateTime @default(now())

  indicadores   PainelIndicador[]

  @@index([escritorioId])
}

model PainelIndicador {
  painelId      String
  painel        Painel    @relation(fields: [painelId], references: [id], onDelete: Cascade)
  indicadorId   String
  indicador     Indicador @relation(fields: [indicadorId], references: [id], onDelete: Cascade)
  ordem         Int       @default(0)

  @@id([painelId, indicadorId])
  @@index([indicadorId])
}

// ============================================================
// MODULO 13 - Notificacoes/Alertas internos + Jobs (scheduler)
// ============================================================

enum TipoNotificacao {
  ENTREGA_ATRASADA
  PRAZO_PROXIMO
  PROTOCOLO_NAO_LIDO
  SOLICITACAO
  PROCESSO
  SISTEMA
}

model Notificacao {
  id           String   @id @default(cuid())
  escritorioId String
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id])
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  tipo         TipoNotificacao @default(SISTEMA)
  titulo       String
  mensagem     String
  link         String?
  lida         Boolean  @default(false)
  lidaEm       DateTime?
  // chave de deduplicacao (ex.: "ENTREGA_ATRASADA:entregaId") para nao recriar
  chave        String?
  createdAt    DateTime @default(now())

  @@unique([usuarioId, chave])
  @@index([escritorioId, usuarioId, lida])
  @@index([usuarioId, createdAt])
}

model JobExecucao {
  id           String   @id @default(cuid())
  escritorioId String?
  escritorio   Escritorio? @relation(fields: [escritorioId], references: [id])
  job          String   // nome do job
  status       String   @default("OK") // OK | ERRO
  itens        Int      @default(0)
  duracaoMs    Int      @default(0)
  detalhe      String?
  createdAt    DateTime @default(now())

  @@index([job, createdAt])
  @@index([escritorioId, createdAt])
}
