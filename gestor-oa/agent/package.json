{
  "name": "@gestoroa/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agente e-Continuo do GestorOA - vigia uma pasta e envia os PDFs novos para o sistema.",
  "bin": { "gestoroa-agent": "index.js" },
  "scripts": {
    "start": "node index.js",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/gestoroa-agent.exe"
  },
  "dependencies": {
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
