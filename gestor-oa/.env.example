# ============================================================
# GestorOA - variaveis de ambiente (copie para .env e ajuste)
# ============================================================

# --- Ambiente ---
NODE_ENV=development
PORT=4002
# URL publica do app (usada em links de protocolo, convites, etc.)
APP_URL=http://localhost:5174
API_URL=http://localhost:4002

# --- Banco de dados (PostgreSQL) ---
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL=postgresql://gestoroa:gestoroa@localhost:5432/gestoroa?schema=public

# --- Autenticacao (JWT) ---
# Gere segredos fortes: openssl rand -hex 48
JWT_ACCESS_SECRET=troque-este-segredo-de-access-token
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-token
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Nome do cookie httpOnly do refresh token
REFRESH_COOKIE_NAME=goa_refresh
# Cookie seguro (true em producao com HTTPS)
COOKIE_SECURE=false

# --- Timezone ---
TZ=America/Sao_Paulo

# --- Armazenamento de arquivos ---
# Em producao na VPS: /var/app/storage
STORAGE_ROOT=./storage

# --- E-mail (SMTP) - padrao do sistema; escritorio pode sobrescrever ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remetente padrao caso o escritorio nao configure
MAIL_FROM_NAME=GestorOA
MAIL_FROM_EMAIL=nao-responder@exemplo.com.br

# --- Filas / Jobs ---
# driver: "bullmq" (requer Redis) ou "postgres" (fallback, sem Redis)
QUEUE_DRIVER=postgres
REDIS_URL=redis://localhost:6379

# --- WhatsApp (Meta Cloud API) - stub; preencher quando integrar ---
WHATSAPP_PROVIDER=wa_me
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- OCR ---
# idioma do Tesseract
OCR_LANG=por
