generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Condicao {
  NOVO_LACRADO
  CAIXA_ABERTA
  AVARIA_ESTETICA
  SEM_CAIXA
  USADO_REVISADO
}

enum StatusProduto {
  RASCUNHO
  ATIVO
  ESGOTADO
  ARQUIVADO
}

enum StatusPedido {
  AGUARDANDO_PAGAMENTO
  PAGO
  SEPARANDO
  PRONTO
  RETIRADO
  EXPIRADO
  CANCELADO
  ESTORNADO
}

enum MetodoPagamento {
  PIX
  CARTAO
  DINHEIRO // PDV
  DEBITO // PDV
  MISTO // PDV: mais de uma forma
}

enum Canal {
  ONLINE
  PDV
}

model Categoria {
  id       String    @id @default(cuid())
  nome     String
  slug     String    @unique
  ordem    Int       @default(0)
  produtos Produto[]
}

model Produto {
  id                String        @id @default(cuid())
  codigo            Int           @unique @default(autoincrement()) // código curto p/ etiqueta/PDV
  slug              String        @unique
  titulo            String
  descricao         String        @default("")
  marca             String?
  sku               String? // código do fabricante / embalagem
  aplicacao         String        @default("") // aplicação/compatibilidade, uma por linha
  videoUrl          String? // link do YouTube ou arquivo enviado (/api/video/...)
  ean               String? // código de barras do fabricante (leitor no PDV)
  estoqueMinimo     Int           @default(0) // alerta de reposição (0 = sem alerta)
  condicao          Condicao      @default(CAIXA_ABERTA)
  categoriaId       String?
  categoria         Categoria?    @relation(fields: [categoriaId], references: [id])
  precoCents        Int
  precoMercadoCents Int? // média de mercado (mostrada riscada)
  custoCents        Int? // custo do lote/unidade (margem)
  estoqueDisponivel Int           @default(1)
  estoqueReservado  Int           @default(0)
  vendidos          Int           @default(0)
  status            StatusProduto @default(ATIVO)
  visualizacoes     Int           @default(0)
  fichaTecnica      Json? // [{ nome, valor }] — vira a tabela "Características" (vem do catálogo do Mercado Livre)
  cadastradoPor     String? // quem cadastrou (usuário do painel ou código de acesso do cadastro rápido)
  etiquetaPendente  Boolean       @default(false) // na fila "A imprimir" da tela de etiquetas
  etiquetaImpressaEm DateTime?
  publicadoEm       DateTime?
  ultimaVendaEm     DateTime?
  criadoEm          DateTime      @default(now())
  atualizadoEm      DateTime      @updatedAt
  fotos             Foto[]
  itens             ItemPedido[]
  movimentos        MovimentoEstoque[]
  itensCompra       CompraItem[]
  disparos          Disparo[]
  cliques           Clique[]

  @@index([status, publicadoEm])
}

model Foto {
  id        String  @id @default(cuid())
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  arquivo   String // nome base; servido em /api/img/<arquivo>.webp e /api/img/<arquivo>-t.webp
  ordem     Int     @default(0)

  @@index([produtoId, ordem])
}

model Cliente {
  id              String   @id @default(cuid())
  nome            String
  telefone        String   @unique // só dígitos, com DDD
  cpf             String?
  email           String?
  asaasCustomerId String?
  senhaHash       String? // conta na loja (opcional — dá pra comprar sem cadastro)
  criadoEm        DateTime @default(now())
  pedidos         Pedido[]

  @@index([email])
}

model Pedido {
  id             String          @id @default(cuid())
  numero         Int             @unique @default(autoincrement())
  acessoToken    String          @unique // link público do pedido
  clienteId      String
  cliente        Cliente         @relation(fields: [clienteId], references: [id])
  canal          Canal           @default(ONLINE)
  status         StatusPedido    @default(AGUARDANDO_PAGAMENTO)
  metodo         MetodoPagamento
  totalCents     Int
  splitPercent   Float?
  asaasPaymentId String?         @unique
  pixPayload     String?
  invoiceUrl     String?
  expiraEm       DateTime? // validade da reserva
  pagoEm         DateTime?
  codigoRetirada String?
  retiradoEm     DateTime?
  estornoCents   Int             @default(0)
  estornadoEm    DateTime?
  origemGrupo    String? // ?g= do link (rastreio por grupo de WhatsApp)
  alerta         String? // ex.: venda dupla evitada
  descontoCents  Int             @default(0) // PDV
  operador       String? // PDV: quem vendeu
  caixaId        String? // PDV: sessão de caixa
  caixa          CaixaSessao?    @relation(fields: [caixaId], references: [id])
  pagamentos     PagamentoPedido[]
  criadoEm       DateTime        @default(now())
  atualizadoEm   DateTime        @updatedAt
  itens          ItemPedido[]
  eventos        EventoPedido[]

  @@index([status, expiraEm])
  @@index([criadoEm])
}

model ItemPedido {
  id             String  @id @default(cuid())
  pedidoId       String
  pedido         Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId      String
  produto        Produto @relation(fields: [produtoId], references: [id])
  quantidade     Int
  precoUnitCents Int
  custoUnitCents Int? // custo do produto no momento da venda (lucro/CMV)
  titulo         String // snapshot
}

model EventoPedido {
  id        String   @id @default(cuid())
  pedidoId  String
  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  tipo      String
  descricao String
  autor     String? // usuário do painel ou "sistema"/"asaas"
  criadoEm  DateTime @default(now())

  @@index([pedidoId, criadoEm])
}

enum Papel {
  ADMIN
  OPERADOR // só frente de caixa, caixa e retirada
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  papel     Papel    @default(ADMIN)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())
}

model Config {
  chave String @id
  valor String
}

model WebhookLog {
  id        String   @id @default(cuid())
  evento    String
  paymentId String?
  payload   Json
  criadoEm  DateTime @default(now())
}

// ---------- Fase 2: disparo nos grupos de WhatsApp ----------

enum StatusDisparo {
  PENDENTE
  ENVIANDO
  ENVIADO
  FALHOU
  CANCELADO
}

enum TipoDisparo {
  NOVO
  PROMOCAO
  REENVIO
}

model Grupo {
  id            String    @id @default(cuid())
  numero        Int       @unique @default(autoincrement()) // vai no link: ?g=<numero>
  jid           String    @unique // id do grupo no WhatsApp (xxx@g.us)
  nome          String
  participantes Int?
  ativo         Boolean   @default(false)
  presente      Boolean   @default(true) // false = o número saiu do grupo (some da lista e não recebe envios)
  criadoEm      DateTime  @default(now())
  disparos      Disparo[]
  cliques       Clique[]
}

model Disparo {
  id           String        @id @default(cuid())
  produtoId    String
  produto      Produto       @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  grupoId      String
  grupo        Grupo         @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  tipo         TipoDisparo   @default(NOVO)
  status       StatusDisparo @default(PENDENTE)
  agendadoPara DateTime      @default(now())
  enviadoEm    DateTime?
  texto        String? // texto efetivamente enviado
  erro         String?
  tentativas   Int           @default(0)
  criadoEm     DateTime      @default(now())

  @@index([status, agendadoPara])
  @@index([grupoId, enviadoEm])
}

model Clique {
  id        String   @id @default(cuid())
  produtoId String
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  grupoId   String?
  grupo     Grupo?   @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  criadoEm  DateTime @default(now())

  @@index([grupoId, criadoEm])
}

// ---------- Loja física: caixa, PDV, estoque, compras, financeiro ----------

enum FormaPagamento {
  DINHEIRO
  PIX // Pix na chave da loja, conferido pelo operador
  PIX_ASAAS // Pix com QR automático (confirmação pelo webhook)
  DEBITO
  CREDITO
  OUTRO
}

enum StatusCaixa {
  ABERTO
  FECHADO
}

model CaixaSessao {
  id                String           @id @default(cuid())
  numero            Int              @unique @default(autoincrement())
  status            StatusCaixa      @default(ABERTO)
  abertoPor         String
  abertoEm          DateTime         @default(now())
  valorInicialCents Int              @default(0) // troco
  fechadoPor        String?
  fechadoEm         DateTime?
  contagem          Json? // { DINHEIRO: 12345, DEBITO: ..., ... } informado no fechamento
  esperadoCents     Int? // dinheiro esperado na gaveta
  contadoCents      Int? // dinheiro contado
  diferencaCents    Int?
  observacao        String?
  movimentos        MovimentoCaixa[]
  pedidos           Pedido[]

  @@index([status])
}

enum TipoMovCaixa {
  VENDA
  SANGRIA
  SUPRIMENTO
  ESTORNO
}

model MovimentoCaixa {
  id         String         @id @default(cuid())
  caixaId    String
  caixa      CaixaSessao    @relation(fields: [caixaId], references: [id], onDelete: Cascade)
  tipo       TipoMovCaixa
  forma      FormaPagamento @default(DINHEIRO)
  valorCents Int // positivo entra, negativo sai
  descricao  String
  pedidoId   String?
  usuario    String
  criadoEm   DateTime       @default(now())

  @@index([caixaId, criadoEm])
}

model PagamentoPedido {
  id         String         @id @default(cuid())
  pedidoId   String
  pedido     Pedido         @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  forma      FormaPagamento
  valorCents Int // valor que abate do total (já sem o troco)
  recebidoCents Int? // dinheiro entregue pelo cliente
  trocoCents Int            @default(0)
}

enum TipoMovEstoque {
  CADASTRO
  ENTRADA_COMPRA
  AJUSTE
  PERDA
  VENDA_ONLINE
  VENDA_PDV
  ESTORNO
}

model MovimentoEstoque {
  id             String         @id @default(cuid())
  produtoId      String
  produto        Produto        @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  tipo           TipoMovEstoque
  quantidade     Int // positivo entrou, negativo saiu
  custoUnitCents Int?
  motivo         String?
  usuario        String         @default("sistema")
  pedidoId       String?
  compraId       String?
  criadoEm       DateTime       @default(now())

  @@index([produtoId, criadoEm])
  @@index([criadoEm])
}

model Fornecedor {
  id         String   @id @default(cuid())
  nome       String
  documento  String? // CNPJ/CPF
  telefone   String?
  email      String?
  observacao String?
  criadoEm   DateTime @default(now())
  compras    Compra[]
}

model Compra {
  id           String       @id @default(cuid())
  numero       Int          @unique @default(autoincrement())
  fornecedorId String?
  fornecedor   Fornecedor?  @relation(fields: [fornecedorId], references: [id])
  data         DateTime     @default(now())
  totalCents   Int
  notaFiscal   String?
  observacao   String?
  usuario      String
  criadoEm     DateTime     @default(now())
  itens        CompraItem[]
}

model CompraItem {
  id             String  @id @default(cuid())
  compraId       String
  compra         Compra  @relation(fields: [compraId], references: [id], onDelete: Cascade)
  produtoId      String
  produto        Produto @relation(fields: [produtoId], references: [id])
  quantidade     Int
  custoUnitCents Int
}

enum TipoLancamento {
  RECEITA
  DESPESA
}

enum StatusLancamento {
  PENDENTE
  PAGO
  CANCELADO
}

model Lancamento {
  id          String           @id @default(cuid())
  tipo        TipoLancamento
  descricao   String
  categoria   String
  valorCents  Int // sempre positivo; o tipo diz se entra ou sai
  vencimento  DateTime
  pagoEm      DateTime?
  status      StatusLancamento @default(PENDENTE)
  forma       FormaPagamento?
  conta       String           @default("Banco") // "Caixa da loja", "Banco", "Asaas"
  origem      String           @default("MANUAL") // MANUAL, VENDA_ONLINE, VENDA_PDV, ESTORNO, COMPRA
  pedidoId    String?
  compraId    String?
  observacao  String?
  usuario     String           @default("sistema")
  criadoEm    DateTime         @default(now())

  @@index([status, vencimento])
  @@index([tipo, pagoEm])
  @@index([pedidoId])
}

// ---------- cadastro rápido (celular) ----------

enum StatusRascunho {
  PROCESSANDO // IA + Mercado Livre trabalhando
  PRONTO // aguardando a pessoa conferir
  ERRO
  PUBLICADO
  DESCARTADO
}

/** Produto fotografado no cadastro rápido, antes de virar Produto (modo esteira). */
model CadastroRascunho {
  id           String         @id @default(cuid())
  status       StatusRascunho @default(PROCESSANDO)
  fotos        String[] // nomes base das fotos já salvas (1ª = capa, 2ª = código de barras)
  ean          String?
  dados        Json? // { ident, ficha, destaques, descricao }
  preco        Json? // ResultadoPreco
  erro         String?
  autor        String
  produtoId    String?
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt

  @@index([status, criadoEm])
}

/** Código de acesso do cadastro rápido (um por pessoa). Guardado só o hash. */
model TokenCadastro {
  id          String    @id @default(cuid())
  nome        String
  hash        String    @unique
  final       String // últimos 2 dígitos, para identificar na lista
  ativo       Boolean   @default(true)
  criadoEm    DateTime  @default(now())
  ultimoUsoEm DateTime?
}
