# Banco (dev usa Postgres embutido: npm run dev sobe sozinho na porta 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/versatil"

# Sessão do painel (gere uma string aleatória longa)
AUTH_SECRET="troque-por-uma-string-aleatoria-longa"

# URL pública do site (links, QR, Open Graph)
PUBLIC_URL="http://localhost:3100"

# Asaas — deixe ASAAS_API_KEY vazio para MODO DEMONSTRAÇÃO (pagamento simulado)
ASAAS_API_KEY=""
ASAAS_ENV="sandbox"            # sandbox | producao
ASAAS_WEBHOOK_TOKEN=""         # mesmo token configurado no webhook do Asaas
ASAAS_SPLIT_WALLET_ID=""       # walletId que recebe a taxa de serviço (split)
ASAAS_SPLIT_PERCENT=""         # % da taxa de serviço (só no servidor; a loja não altera)

# Pasta das fotos enviadas
UPLOAD_DIR="./uploads"

# Usuário inicial do painel (criado pelo seed)
SEED_ADMIN_EMAIL="admin@l3salvados.local"
SEED_ADMIN_SENHA="l3salvados123"

# WhatsApp (Evolution API) — vazio = MODO DEMONSTRAÇÃO (disparos simulados, grupos de teste)
EVOLUTION_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""

# Pesquisa de preço (cadastro de produto)
GEMINI_API_KEY=""            # IA que reconhece o produto pela foto
GEMINI_MODEL="gemini-2.5-flash"
ML_CLIENT_ID=""              # aplicação em developers.mercadolivre.com.br
ML_CLIENT_SECRET=""
ML_REDIRECT_URI="https://www.google.com/"   # o mesmo cadastrado na aplicação do ML
