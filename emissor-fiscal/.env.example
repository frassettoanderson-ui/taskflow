# ============================================================
# Emissor Fiscal — configuração GLOBAL do motor
# Copie para .env. Dados por empresa ficam em config/emitentes.json.
# ============================================================

# Ambiente SEFAZ: 1 = Produção, 2 = Homologação (teste, sem valor fiscal)
FISCAL_AMBIENTE=2

# Emitentes (CNPJ, certificado, série, CSC) -> config/emitentes.json
#   copie de config/emitentes.example.json
# Chaves de API e escopo por emitente     -> config/api-keys.json
#   copie de config/api-keys.example.json  (gere chaves: openssl rand -hex 32)
