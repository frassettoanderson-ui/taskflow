# ============================================================
# Emissor Fiscal — configuração
# Copie para .env e preencha. NUNCA versione o .env real.
# ============================================================

# Ambiente SEFAZ: 1 = Produção, 2 = Homologação (teste, sem valor fiscal)
FISCAL_AMBIENTE=2

# Chave de API interna: os projetos consumidores enviam no header
#   Authorization: Bearer <esta-chave>
# Gere uma forte: openssl rand -hex 32
API_KEY=troque-esta-chave

# --- Dados do emitente (empresa que emite as notas) ---
EMIT_CNPJ=00000000000000
EMIT_RAZAO="RAZAO SOCIAL LTDA"
EMIT_FANTASIA="Nome Fantasia"
EMIT_IE=ISENTO
EMIT_IM=
# Regime tributário: 1=Simples Nacional, 2=Simples excesso sublimite, 3=Regime Normal
EMIT_CRT=1
EMIT_UF=SC
EMIT_MUNICIPIO_COD=4205407
EMIT_MUNICIPIO_NOME="Imbituba"
EMIT_LOGRADOURO="Rua Exemplo"
EMIT_NUMERO=100
EMIT_BAIRRO="Centro"
EMIT_CEP=88780000
EMIT_FONE=48999999999

# --- Certificado digital A1 (.pfx / .p12) ---
# Caminho relativo à raiz do projeto ou absoluto.
CERT_PATH=storage/certificados/certificado.pfx
CERT_PASSWORD=senha-do-certificado

# --- Numeração (série e próximo número por modelo) ---
# Em produção isso deve vir de um banco/contador atômico. Ver Support/Contador.
NFE_SERIE=1
NFCE_SERIE=1
# ID do Código de Segurança do Contribuinte (CSC) — necessário só p/ NFC-e
NFCE_CSC_ID=000001
NFCE_CSC=
