# Porta interna do app (nginx faz proxy do dominio para ca)
PORT=3002

# Caminho base quando rodar sob subpasta no hub (ex.: /igreja).
# Deixe vazio para rodar na raiz em ambiente local.
BASE_PATH=

# PostgreSQL
DATABASE_URL=postgres://igreja_user:senha_aqui@localhost:5432/db_igreja

# Sessao (troque por uma string aleatoria longa em producao)
SESSION_SECRET=troque-este-segredo
